diff --git a/asm/macros/ptr.inc b/asm/macros/ptr.inc
new file mode 100644
index 000000000..a0655bb6b
--- /dev/null
+++ b/asm/macros/ptr.inc
@@ -0,0 +1,57 @@
+// Pointer emission that adapts to the target's pointer width.
+//
+// The decomp emits data pointers as .4byte/.int, which is correct for a 32-bit
+// target but produces R_AARCH64_ABS32 relocations on arm64 -- and an absolute
+// 32-bit relocation against a symbol cannot exist in a shared object, which is
+// what an Android app always is.
+//
+// Assemble with --defsym PTR64=1 for a 64-bit target; leaving it undefined
+// keeps the original 32-bit output byte for byte, so the existing armeabi-v7a
+// build needs no changes. The .balign inside `ptr` mirrors exactly what the C
+// compiler does when it aligns a pointer field, so struct layouts agree.
+
+// Include guard: this file is pulled in from asm/macros.inc and directly
+// from the sound macros, and gas rejects a duplicate .macro definition.
+	.ifdef PTR_INC_INCLUDED
+	.else
+	.equiv PTR_INC_INCLUDED, 1
+
+	.macro palign
+	.ifdef PTR64
+	.balign 8
+	.else
+	.balign 4
+	.endif
+	.endm
+
+	.macro ptr label:req
+	.ifdef PTR64
+	.balign 8
+	.quad \label
+	.else
+	.4byte \label
+	.endif
+	.endm
+	// Pointer inside a bytecode stream. Identical to `ptr` except that it
+	// never aligns: script bytecode is walked sequentially by an interpreter
+	// that has no idea padding exists, so inserting any would desynchronise
+	// it. Unaligned .quad is legal and relocates fine on arm64.
+	.macro ptr_stream label:req
+	.ifdef PTR64
+	.quad \label
+	.else
+	.4byte \label
+	.endif
+	.endm
+
+
+	// Four bytes of padding that exist only on a 64-bit target. Used where a
+	// 32-bit layout packs a 4-byte field into a slot that becomes 8 bytes
+	// wide once pointers grow -- a union with a pointer member, for example.
+	.macro pad32
+	.ifdef PTR64
+	.space 4
+	.endif
+	.endm
+
+	.endif
