+# The game data is assembled with a bare-metal binutils and linked into
+# libmain.so. On a 64-bit target that has to be the aarch64 assembler, and the
+# pointer macros in asm/macros/ptr.inc need PTR64 defined so they emit 8-byte
+# pointers. See android-build/ARM64-PORT.md.
+if(ANDROID_ABI STREQUAL "arm64-v8a")
+    find_program(DATA_AS aarch64-linux-gnu-as
+        HINTS "$ENV{AARCH64_TOOLCHAIN}/bin" REQUIRED)
+    find_program(DATA_LD aarch64-linux-gnu-ld
+        HINTS "$ENV{AARCH64_TOOLCHAIN}/bin" REQUIRED)
+    find_program(DATA_OBJCOPY aarch64-linux-gnu-objcopy
+        HINTS "$ENV{AARCH64_TOOLCHAIN}/bin" REQUIRED)
+    set(DATA_AS_FLAGS --defsym PTR64=1)
+else()
+    find_program(DATA_AS arm-none-eabi-as
+        HINTS "$ENV{ARM_NONE_EABI_TOOLCHAIN}/bin" REQUIRED)
+    find_program(DATA_LD arm-none-eabi-ld
+        HINTS "$ENV{ARM_NONE_EABI_TOOLCHAIN}/bin" REQUIRED)
+    find_program(DATA_OBJCOPY arm-none-eabi-objcopy
+        HINTS "$ENV{ARM_NONE_EABI_TOOLCHAIN}/bin" REQUIRED)
+    set(DATA_AS_FLAGS -march=armv7-a)
+endif()
