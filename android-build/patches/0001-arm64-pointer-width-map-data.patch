index e6f4aaf6a..4aa61375c 100644
--- a/src/platform/sdl2.c
+++ b/src/platform/sdl2.c
@@ -87,8 +87,152 @@ static void HandleTouchEvent(const SDL_TouchFingerEvent *event);
 static void DrawTouchControls(void);
 #endif
 
+
+// A crash on a phone is otherwise invisible: the app just disappears, and
+// pulling logcat off a device is more than most people want to do. This puts
+// the faulting signal, the address and the top of the backtrace into a dialog
+// on screen, so a crash can simply be read off and reported.
+//
+// Frames are printed relative to main(), whose own offset inside libmain.so is
+// known, so the numbers resolve with addr2line against the unstripped .so that
+// CI keeps as an artifact. (dladdr would be tidier but needs _GNU_SOURCE
+// before the first libc header, which this file cannot arrange.)
+#include <signal.h>
+// __linux__ rather than NATIVE_LINUX: the Makefile only defines the latter in
+// CPPFLAGS, for the preproc pass, not in the CFLAGS that reach the compiler --
+// so keying on it silently compiled this whole handler out of the desktop
+// build. __linux__ is predefined by the compiler, and Android defines it too.
+#if defined(__linux__)
+#include <ucontext.h>
+
+// backtrace() is a glibc thing. Checking for <execinfo.h> is NOT enough: the
+// NDK ships the header, so __has_include succeeds, and the build then fails at
+// link time with "undefined symbol: backtrace" because bionic does not export
+// it at this API level. So exclude Android outright.
+//
+// No loss: the signal, the fault address and the PC from ucontext are what
+// actually locate the bug. The frame list is a convenience on desktop.
+#if !defined(__ANDROID__) && defined(__has_include)
+#if __has_include(<execinfo.h>)
+#include <execinfo.h>
+#define HAVE_BACKTRACE 1
+#endif
+#endif
+
+int main(int argc, char **argv); // for the offsets printed below
+
+static const struct sigaction *FindOldHandler(int sig);
+
+static void CrashHandler(int sig, siginfo_t *info, void *ucontext)
+{
+    char msg[2048];
+    void *frames[16];
+    int n, i;
+    size_t len;
+    const char *name;
+
+    switch (sig)
+    {
+    case SIGSEGV: name = "SIGSEGV (bad address)";    break;
+    case SIGBUS:  name = "SIGBUS (misaligned)";      break;
+    case SIGILL:  name = "SIGILL (bad instruction)"; break;
+    case SIGFPE:  name = "SIGFPE";                   break;
+    default:      name = "signal";                   break;
+    }
+
+    // The faulting PC is the number that actually locates the bug; si_addr is
+    // only the address that was touched. ucontext carries the PC per-arch.
+    {
+        void *pc = NULL;
+#if defined(__aarch64__)
+        pc = (void *)((ucontext_t *)ucontext)->uc_mcontext.pc;
+#elif defined(__arm__)
+        pc = (void *)((ucontext_t *)ucontext)->uc_mcontext.arm_pc;
+#elif defined(__x86_64__)
+        pc = (void *)((ucontext_t *)ucontext)->uc_mcontext.gregs[16]; // REG_RIP, by index to avoid _GNU_SOURCE
+#endif
+        len = SDL_snprintf(msg, sizeof(msg),
+                           "%s\nfault address: %p\nPC: %p  (main%+ld)\nmain: %p\n\n",
+                           name, info ? info->si_addr : NULL, pc,
+                           pc ? (long)((intptr_t)pc - (intptr_t)&main) : 0L,
+                           (void *)&main);
+    }
+
+#ifdef HAVE_BACKTRACE
+    n = backtrace(frames, (int)(sizeof(frames) / sizeof(frames[0])));
+    for (i = 0; i < n && len < sizeof(msg) - 64; i++)
+    {
+        long delta = (long)((intptr_t)frames[i] - (intptr_t)&main);
+
+        len += SDL_snprintf(msg + len, sizeof(msg) - len,
+                            "%d: main%+ld\n", i, delta);
+    }
+#else
+    (void)frames;
+    (void)n;
+    (void)i;
+#endif
+
+    SDL_Log("CRASH\n%s", msg);
+    SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "pokeemerald crashed", msg, NULL);
+
+    // Chain to whatever was installed before us rather than just dying. This
+    // matters on Android: the runtime installs its own SIGSEGV handler and uses
+    // faults internally (implicit null checks, stack guards), so swallowing
+    // them would break the app rather than merely report on it.
+    {
+        const struct sigaction *old = FindOldHandler(sig);
+
+        if (old != NULL && (old->sa_flags & SA_SIGINFO) && old->sa_sigaction != NULL)
+        {
+            old->sa_sigaction(sig, info, ucontext);
+            return;
+        }
+        if (old != NULL && old->sa_handler != SIG_DFL && old->sa_handler != SIG_IGN)
+        {
+            old->sa_handler(sig);
+            return;
+        }
+    }
+
+    // Nothing to chain to: restore the default action and re-raise, so the
+    // process still dies with the right status instead of looping here.
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+static const int sCrashSignals[] = { SIGSEGV, SIGBUS, SIGILL, SIGFPE };
+static struct sigaction sOldHandlers[4];
+
+static const struct sigaction *FindOldHandler(int sig)
+{
+    size_t i;
+
+    for (i = 0; i < sizeof(sCrashSignals) / sizeof(sCrashSignals[0]); i++)
+        if (sCrashSignals[i] == sig)
+            return &sOldHandlers[i];
+    return NULL;
+}
+
+static void InstallCrashHandler(void)
+{
+    struct sigaction sa;
+    size_t i;
+
+    SDL_memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = CrashHandler;
+    sa.sa_flags = SA_SIGINFO;
+
+    for (i = 0; i < sizeof(sCrashSignals) / sizeof(sCrashSignals[0]); i++)
+        sigaction(sCrashSignals[i], &sa, &sOldHandlers[i]);
+}
+#else
+static void InstallCrashHandler(void) {}
+#endif
+
 int main(int argc, char **argv)
 {
+    InstallCrashHandler();
     // Open an output console on Windows
 #ifdef _WIN32
     AllocConsole() ;
@@ -1057,16 +1201,75 @@ u16 GetXInputKeys()
 }
 #endif // _WIN32
 
+// Synthetic input for headless testing. The CI runtime check has no way to
+// press a button, so the game could only ever be observed sitting on the title
+// screen -- every menu, and every transition between screens, went untested.
+//
+//   POKE_AUTOKEYS="600=START 900=A"
+//
+// presses that button for a few frames at that frame number. With the variable
+// unset nothing changes at all.
+static u16 AutoKeys(void)
+{
+    static const struct { const char *name; u16 bit; } names[] = {
+        { "A", A_BUTTON }, { "B", B_BUTTON }, { "START", START_BUTTON },
+        { "SELECT", SELECT_BUTTON }, { "UP", DPAD_UP }, { "DOWN", DPAD_DOWN },
+        { "LEFT", DPAD_LEFT }, { "RIGHT", DPAD_RIGHT },
+    };
+    static unsigned long frame;
+    static const char *script;
+    static bool checked;
+    const char *p;
+    u16 keys = 0;
+
+    if (!checked)
+    {
+        script = SDL_getenv("POKE_AUTOKEYS");
+        checked = true;
+    }
+    frame++;
+    if (script == NULL)
+        return 0;
+
+    // Held for 8 frames so the game samples it as a fresh press.
+    for (p = script; *p != '\0'; p++)
+    {
+        unsigned long at = SDL_strtoul(p, (char **)&p, 10);
+        size_t i;
+
+        if (*p != '=')
+            break;
+        p++;
+        for (i = 0; i < sizeof(names) / sizeof(names[0]); i++)
+        {
+            size_t n = SDL_strlen(names[i].name);
+
+            if (SDL_strncmp(p, names[i].name, n) == 0)
+            {
+                if (frame >= at && frame < at + 8)
+                    keys |= names[i].bit;
+                p += n;
+                break;
+            }
+        }
+        while (*p != '\0' && *p != ' ')
+            p++;
+        if (*p == '\0')
+            break;
+    }
+    return keys;
+}
+
 u16 Platform_GetKeyInput(void)
 {
 #ifdef _WIN32
     u16 gamepadKeys = GetXInputKeys();
-    return gamepadKeys | keyboardKeys;
+    return gamepadKeys | keyboardKeys | AutoKeys();
 #elif defined(__ANDROID__)
-    return keyboardKeys | controllerKeys | controllerAxisKeys;
+    return keyboardKeys | controllerKeys | controllerAxisKeys | AutoKeys();
 #endif
 
-    return keyboardKeys;
+    return keyboardKeys | AutoKeys();
 }
 
 void VDraw(SDL_Texture *texture)
