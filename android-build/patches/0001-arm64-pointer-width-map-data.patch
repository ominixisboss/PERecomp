diff --git a/include/global.h b/include/global.h
index 1653b3a07..132e22d66 100644
--- a/include/global.h
+++ b/include/global.h
@@ -132,6 +132,20 @@ int strcmp(const char *, const char*);
 #define T1_READ_32(ptr) ((ptr)[0] | ((ptr)[1] << 8) | ((ptr)[2] << 16) | ((ptr)[3] << 24))
 #define T1_READ_PTR(ptr) (u8 *) T1_READ_32(ptr)
 
+// Reads a pointer out of a bytecode stream at the target's pointer width.
+// Bytecode is walked sequentially, so the emission (ptr_stream in
+// asm/macros/ptr.inc) and this reader must agree on the width.
+static inline u8 *ReadStreamPtr(const u8 *p)
+{
+    uintptr_t value = 0;
+    u32 i;
+
+    for (i = 0; i < sizeof(uintptr_t); i++)
+        value |= (uintptr_t)p[i] << (i * 8);
+
+    return (u8 *)value;
+}
+
 // T2_READ_8 is a duplicate to remain consistent with each group.
 #define T2_READ_8(ptr)  ((ptr)[0])
 #define T2_READ_16(ptr) ((ptr)[0] + ((ptr)[1] << 8))
