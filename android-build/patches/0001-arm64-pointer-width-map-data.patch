 	.byte 0
 	_voice_directsound \base_midi_key, \pan, \sample_data_pointer, \attack, \decay, \sustain, \release
+	// 64-bit only: a 32-bit entry is already exactly VOICE_ENTRY_SIZE, and
+	// emitting .space 0 there just produces a warning per entry. (.if cannot
+	// be used to guard it -- ptr's .balign makes `. - 99b` non-constant at
+	// parse time.)
+	.ifdef PTR64
+	.space VOICE_ENTRY_SIZE - (. - 99b)
+	.endif
