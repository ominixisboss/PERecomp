+// Each voice entry is one struct ToneData, which is 12 bytes on a 32-bit
+// target and 24 on a 64-bit one (4 u8, 4 pad, an 8-byte pointer, 4 u8, 4 pad).
+// The `ptr` macro aligns the pointer *within* an entry, but that is not enough
+// on its own: without padding each entry out to the full struct size, entry N
+// starts wherever entry N-1 happened to end and every field after the first
+// entry is skewed. voice_group indexes by 0x18, so each entry must occupy
+// exactly that. 24 is not a power of two, so .balign cannot produce the
+// stride -- alignment alone leaves a pointerless entry (square/noise) at 16
+// bytes and the next entry's header leaks into its ADSR slot. Each entry
+// macro below therefore records its start and pads out to VOICE_ENTRY_SIZE.
+	.include "asm/macros/ptr.inc"
+
+	.ifdef PTR64
+	.equiv VOICE_ENTRY_SIZE, 0x18
+	.else
+	.equiv VOICE_ENTRY_SIZE, 0xC
+	.endif
 	.macro voice_directsound base_midi_key:req, pan:req, sample_data_pointer:req, attack:req, decay:req, sustain:req, release:req
+	palign
