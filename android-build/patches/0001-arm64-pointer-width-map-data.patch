+// sequentially, so this and the ptr_stream emission must agree on the width.
+uintptr_t FieldEffectScript_ReadPtr(u8 **script)
+{
+    uintptr_t value = 0;
+    u32 i;
+
+    for (i = 0; i < sizeof(uintptr_t); i++)
+        value |= (uintptr_t)(*script)[i] << (i * 8);
