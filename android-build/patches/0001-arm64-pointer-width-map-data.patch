 #ifndef GUARD_GBA_FLASH_INTERNAL_H
 #define GUARD_GBA_FLASH_INTERNAL_H
 
+// A 64-bit build's SaveBlock1 is 512 bytes larger than a 32-bit one -- it
+// embeds 64 ObjectEventTemplates, and each grows from 24 to 32 bytes once its
+// script pointer is 8 bytes wide. That overruns the four sectors the GBA save
+// layout allots it, so save.h gives SaveBlock1 a fifth sector there. That
+// pushes each of the two save slots up by one sector and the four sectors
+// after the slots up by two, so the emulated flash grows to match. A 32-bit
+// build keeps the GBA's exact 32-sector geometry.
+#if __SIZEOF_POINTER__ > 4
+#define FLASH_NUM_SECTORS 34
+#else
+#define FLASH_NUM_SECTORS 32
+#endif
+#define FLASH_SECTOR_SIZE 4096
+#define FLASH_ROM_SIZE (FLASH_NUM_SECTORS * FLASH_SECTOR_SIZE)
