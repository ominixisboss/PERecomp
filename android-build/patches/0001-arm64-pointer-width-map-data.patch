diff --git a/Makefile_pc b/Makefile_pc
index f961d552e..e2d917874 100644
--- a/Makefile_pc
+++ b/Makefile_pc
@@ -1,5 +1,25 @@
 NATIVE_LINUX ?= 0
 
+# Pointer width for the native build. BITS=64 selects the 64-bit assembler and
+# compiler modes and defines PTR64, so the macros in asm/macros/ptr.inc emit
+# 8-byte pointers throughout the game data. The default is 32, which is what
+# the Windows target and the original Linux target use, and which produces
+# byte-identical output to before this knob existed.
+#
+# A 64-bit native build is the only way to exercise the pointer-width port
+# without an arm64 device: it runs exactly the same widened data and the same
+# sizeof(void *) reader paths as the Android arm64-v8a build.
+BITS ?= 32
+ifeq ($(BITS),64)
+AS_BITS := --64
+CC_BITS := -m64
+PTR64_DEFSYM := --defsym PTR64=1
+else
+AS_BITS := --32
+CC_BITS := -m32
+PTR64_DEFSYM :=
+endif
+
 ifeq ($(NATIVE_LINUX),1)
 PREFIX :=
 SDL_DIR :=
@@ -63,12 +83,12 @@ DATA_ASM_BUILDDIR = $(OBJ_DIR)/$(DATA_ASM_SUBDIR)
 SONG_BUILDDIR = $(OBJ_DIR)/$(SONG_SUBDIR)
 MID_BUILDDIR = $(OBJ_DIR)/$(MID_SUBDIR)
 
-ASFLAGS := --32 --defsym MODERN=$(MODERN) --defsym PORTABLE=1 --defsym UBFIX=1
+ASFLAGS := $(AS_BITS) $(PTR64_DEFSYM) --defsym MODERN=$(MODERN) --defsym PORTABLE=1 --defsym UBFIX=1
 
 GCC_VER := $(shell $(CC) -dumpversion)
 
 CC1 	:= $(shell $(PREFIX)gcc --print-prog-name=cc1) -quiet
-override CFLAGS += -Wno-trigraphs -Wimplicit -Wparentheses -Wunused -m32 -std=gnu99 -fno-dce -fno-builtin -Wno-unused-function -DPORTABLE -DNONMATCHING -D UBFIX -DMODERN=$(MODERN)
+override CFLAGS += -Wno-trigraphs -Wimplicit -Wparentheses -Wunused $(CC_BITS) -std=gnu99 -fno-dce -fno-builtin -Wno-unused-function -DPORTABLE -DNONMATCHING -D UBFIX -DMODERN=$(MODERN)
 ifeq ($(NATIVE_LINUX),1)
 override CFLAGS += -fno-pie
 ROM := pokeemerald
@@ -81,7 +101,7 @@ endif
 
 CPPFLAGS := -std=gnu99 -iquote include -iquote $(GFLIB_SUBDIR) -Wno-trigraphs -D NONMATCHING -D PORTABLE -D $(TARGET_PLATFORM) -D $(TILE_RENDERER) -D MODERN=$(MODERN) -D UBFIX
 ifeq ($(NATIVE_LINUX),1)
-CPPFLAGS += -m32 -D NATIVE_LINUX $(shell pkg-config --cflags sdl2 SDL2_image)
+CPPFLAGS += $(CC_BITS) -D NATIVE_LINUX $(shell pkg-config --cflags sdl2 SDL2_image)
 else
 CPPFLAGS += -I$(SDL_DIR)/include -L$(SDL_DIR)/lib
 endif
