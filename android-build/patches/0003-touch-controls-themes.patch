+package com.pokeemerald.experimental;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Environment;
+import android.provider.MediaStore;
+import android.widget.Toast;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+
+/**
+ * Keeps the save safe across reinstalls.
+ *
+ * The game's save lives in the app's private storage (SDL_GetPrefPath on
+ * Android is getFilesDir()), which survives an update but is deleted on
+ * uninstall. So:
+ *  - on every pause, a copy goes to Downloads/PokemonEmerald/ (Android 10+,
+ *    no permission needed), which outlives an uninstall;
+ *  - "Back up save" and "Restore save" in the settings panel move a save
+ *    through the system file picker, for any version and any folder.
+ */
+final class SaveTransfer {
+    static final int REQUEST_EXPORT = 7101, REQUEST_IMPORT = 7102;
+    private static final String SAVE = "pokeemerald.sav";
+    private static final String BACKUP_NAME = "pokeemerald-backup.sav";
+    private static final String FOLDER = Environment.DIRECTORY_DOWNLOADS + "/PokemonEmerald";
+    // A real save is the 128KB (GBA) or 136KB (64-bit build) flash image.
+    private static final long MIN_SIZE = 64 * 1024, MAX_SIZE = 256 * 1024;
+
+    private SaveTransfer() {}
+
+    static File saveFile(Context c) {
+        return new File(c.getFilesDir(), SAVE);
+    }
+
+    /** True if the file holds anything but erased flash (all 0xFF). */
+    private static boolean hasData(File f) {
+        if (!f.isFile() || f.length() < MIN_SIZE) return false;
+        byte[] buf = new byte[8192];
+        try (InputStream in = new FileInputStream(f)) {
+            int n;
+            while ((n = in.read(buf)) > 0)
+                for (int i = 0; i < n; i++) if (buf[i] != (byte) 0xFF) return true;
+        } catch (IOException ignored) {
+        }
+        return false;
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws IOException {
+        byte[] buf = new byte[16384];
+        int n;
+        while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+    }
+
+    /** Called from onPause. Cheap when nothing changed since the last copy. */
+    static void autoBackup(Context c) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return;
+        File save = saveFile(c);
+        if (!hasData(save)) return;
+        SharedPreferences prefs = c.getSharedPreferences("saves", Context.MODE_PRIVATE);
+        long stamp = save.lastModified() ^ save.length();
+        if (prefs.getLong("backupStamp", 0) == stamp) return;
+        ContentResolver cr = c.getContentResolver();
+        Uri uri = null;
+        String known = prefs.getString("backupUri", null);
+        if (known != null) {
+            uri = Uri.parse(known);
+            try (OutputStream out = cr.openOutputStream(uri, "wt"); InputStream in = new FileInputStream(save)) {
+                if (out == null) throw new IOException("no stream");
+                copy(in, out);
+                prefs.edit().putLong("backupStamp", stamp).apply();
+                return;
+            } catch (IOException | RuntimeException e) {
+                uri = null;   // deleted by the user, or from an old install: make a new one
+            }
+        }
+        ContentValues v = new ContentValues();
+        v.put(MediaStore.MediaColumns.DISPLAY_NAME, BACKUP_NAME);
+        v.put(MediaStore.MediaColumns.MIME_TYPE, "application/octet-stream");
+        v.put(MediaStore.MediaColumns.RELATIVE_PATH, FOLDER);
+        try {
+            uri = cr.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, v);
+            if (uri == null) return;
+            try (OutputStream out = cr.openOutputStream(uri, "wt"); InputStream in = new FileInputStream(save)) {
+                if (out == null) return;
+                copy(in, out);
+            }
+            prefs.edit().putString("backupUri", uri.toString()).putLong("backupStamp", stamp).apply();
+        } catch (IOException | RuntimeException ignored) {
+            // Best effort: a failed backup must never disturb the game.
+        }
+    }
+
+    static void requestExport(Activity a) {
+        if (!saveFile(a).isFile()) {
+            Toast.makeText(a, "No save yet -- save in the game first.", Toast.LENGTH_LONG).show();
+            return;
+        }
+        Intent i = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        i.addCategory(Intent.CATEGORY_OPENABLE);
+        i.setType("application/octet-stream");
+        i.putExtra(Intent.EXTRA_TITLE, SAVE);
+        a.startActivityForResult(i, REQUEST_EXPORT);
+    }
+
+    static void requestImport(Activity a) {
+        Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        i.addCategory(Intent.CATEGORY_OPENABLE);
+        i.setType("*/*");
+        a.startActivityForResult(i, REQUEST_IMPORT);
+    }
+
+    /** Returns true if the result was one of ours. */
+    static boolean onActivityResult(Activity a, int request, int result, Intent data) {
+        if (request != REQUEST_EXPORT && request != REQUEST_IMPORT) return false;
+        if (result != Activity.RESULT_OK || data == null || data.getData() == null) return true;
+        Uri uri = data.getData();
+        if (request == REQUEST_EXPORT) {
+            try (OutputStream out = a.getContentResolver().openOutputStream(uri, "wt");
+                 InputStream in = new FileInputStream(saveFile(a))) {
+                if (out == null) throw new IOException("no stream");
+                copy(in, out);
+                Toast.makeText(a, "Save backed up.", Toast.LENGTH_LONG).show();
+            } catch (IOException e) {
+                Toast.makeText(a, "Backup failed: " + e.getMessage(), Toast.LENGTH_LONG).show();
+            }
+        } else {
+            confirmImport(a, uri);
+        }
+        return true;
+    }
+
+    private static void confirmImport(Activity a, Uri uri) {
+        new AlertDialog.Builder(a, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+                .setTitle("Replace your save?")
+                .setMessage("The current save is kept as pokeemerald.sav.bak inside the app. "
+                        + "The game restarts to load the restored save.")
+                .setPositiveButton("Replace", (d, w) -> importFrom(a, uri))
+                .setNegativeButton("Cancel", null)
+                .show();
+    }
+
+    private static void importFrom(Activity a, Uri uri) {
+        File save = saveFile(a);
+        File incoming = new File(a.getFilesDir(), SAVE + ".incoming");
+        try (InputStream in = a.getContentResolver().openInputStream(uri);
+             OutputStream out = new FileOutputStream(incoming)) {
+            if (in == null) throw new IOException("cannot open the file");
+            copy(in, out);
+        } catch (IOException e) {
+            Toast.makeText(a, "Restore failed: " + e.getMessage(), Toast.LENGTH_LONG).show();
+            incoming.delete();
+            return;
+        }
+        if (incoming.length() < MIN_SIZE || incoming.length() > MAX_SIZE) {
+            Toast.makeText(a, "That does not look like a save file (" + incoming.length() + " bytes).",
+                    Toast.LENGTH_LONG).show();
+            incoming.delete();
+            return;
+        }
+        File bak = new File(a.getFilesDir(), SAVE + ".bak");
+        if (save.isFile()) {
+            bak.delete();
+            save.renameTo(bak);
+        }
+        if (!incoming.renameTo(save)) {
+            Toast.makeText(a, "Restore failed: could not replace the save.", Toast.LENGTH_LONG).show();
+            if (bak.isFile()) bak.renameTo(save);
+            return;
+        }
+        // The game holds the old save in memory and would write it back on
+        // the next in-game save, so restart it: relaunch, then end this process.
+        Intent relaunch = a.getPackageManager().getLaunchIntentForPackage(a.getPackageName());
+        if (relaunch != null) {
+            relaunch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+            a.startActivity(relaunch);
+        }
+        Runtime.getRuntime().exit(0);
+    }
+}
