+        new ButtonStyle("Minimal", argb(0, 0xFFFFFF), argb(90, 0xFFFFFF), argb(150, 0xFFFFFF),
+                argb(200, 0xFFFFFF), argb(0, 0xFFFFFF), 0, 0, true),
+        new ButtonStyle("Emerald", argb(130, 0x0E6B4E), argb(210, 0x1FA67A), argb(200, 0x8FF0C8),
+                argb(255, 0xEFFFF8), argb(130, 0x0E6B4E), argb(200, 0x22B884), argb(200, 0x157A5C), false),
+        new ButtonStyle("Magma", argb(140, 0x5A1206), argb(220, 0xC8401A), argb(210, 0xFF9A3C),
+                argb(255, 0xFFE0C0), argb(140, 0x5A1206), argb(210, 0xE0501E), argb(210, 0x9A2A10), false),
+        new ButtonStyle("Aqua", argb(130, 0x0C3A6E), argb(210, 0x2A78C8), argb(210, 0x8CD0FF),
+                argb(255, 0xE6F4FF), argb(130, 0x0C3A6E), argb(200, 0x2F8AE0), argb(200, 0x1B5A9E), false),
+        new ButtonStyle("Retro Green", argb(150, 0x306230), argb(220, 0x8BAC0F), argb(220, 0x0F380F),
+                argb(255, 0x9BBC0F), argb(150, 0x306230), argb(200, 0x0F380F), argb(200, 0x0F380F), false),
+        // Handheld shells. Colours after the classic 2001 plastics; no logos.
+        //              name                shell     shade     ink       A/B face  pad
+        gba("Handheld Indigo",   0x4B3D92, 0x332868, 0xC9C2EE, 0xB7AEDD, 0x1C1C22),
