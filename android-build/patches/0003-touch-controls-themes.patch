+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.HorizontalScrollView;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+import com.pokeemerald.experimental.controls.ThemeCard;
+import com.pokeemerald.experimental.controls.Themes;
+
+/**
+ * The theme picker: category tabs over a grid of cards, each a miniature of
+ * the theme as it looks on the phone (its background, a stand-in screen and
+ * its matching buttons). Tapping a card applies it at once.
+ */
+final class ThemeGallery {
+    private ThemeGallery() {}
+
+    private static final int ACCENT = 0xFF2FB87E, CARD_BG = 0xFF1E232B, PANEL = 0xF2121519;
+    private static final int THUMB_W = 360, THUMB_H = THUMB_W * ThemeCard.H / ThemeCard.W;
+
+    /** Rendered cards, kept across openings (about 15MB at most). */
+    private static final LruCache<String, Bitmap> cache = new LruCache<String, Bitmap>(16 * 1024 * 1024) {
+        @Override protected int sizeOf(String key, Bitmap b) { return b.getByteCount(); }
+    };
+    private static final ExecutorService worker = Executors.newSingleThreadExecutor();
+
+    /** "None" is shown as the last card of Minimal. */
+    private static final String NONE = "none";
+
+    static void show(GbaControlsView view, Runnable onChange) {
+        Context c = view.getContext();
+        Dialog dialog = new Dialog(c, android.R.style.Theme_DeviceDefault_NoActionBar_Fullscreen);
+        Window win = dialog.getWindow();
+        if (win != null) win.setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN, WindowManager.LayoutParams.FLAG_FULLSCREEN);
+
+        LinearLayout root = new LinearLayout(c);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(PANEL);
+        int pad = dp(c, 12);
+        root.setPadding(pad, pad / 2, pad, 0);
+
+        // Title row: "Themes", what is on now, and Done.
+        LinearLayout top = new LinearLayout(c);
+        top.setGravity(Gravity.CENTER_VERTICAL);
+        TextView title = label(c, "Themes", 22, Color.WHITE, true);
+        TextView current = label(c, "", 14, 0xFFB8C2CC, false);
+        current.setPadding(dp(c, 16), 0, 0, 0);
+        TextView done = label(c, "Done", 16, ACCENT, true);
+        done.setPadding(dp(c, 16), dp(c, 8), dp(c, 8), dp(c, 8));
+        top.addView(title);
+        top.addView(current, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        top.addView(done);
+        root.addView(top);
+
+        // Category tabs.
+        HorizontalScrollView tabScroll = new HorizontalScrollView(c);
+        tabScroll.setHorizontalScrollBarEnabled(false);
+        LinearLayout tabs = new LinearLayout(c);
+        tabs.setPadding(0, dp(c, 4), 0, dp(c, 8));
+        tabScroll.addView(tabs);
+        root.addView(tabScroll);
+
+        ScrollView gridScroll = new ScrollView(c);
+        LinearLayout grid = new LinearLayout(c);
+        grid.setOrientation(LinearLayout.VERTICAL);
+        grid.setPadding(0, 0, 0, pad);
+        gridScroll.addView(grid);
+        root.addView(gridScroll, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1));
+
+        dialog.setContentView(root);
+
+        final State st = new State(view, onChange, current, grid, tabs);
+        for (String cat : Themes.CATEGORIES) {
+            TextView tab = label(c, cat + "  " + count(cat), 15, Color.WHITE, true);
+            tab.setPadding(dp(c, 14), dp(c, 8), dp(c, 14), dp(c, 8));
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            lp.rightMargin = dp(c, 8);
+            tab.setOnClickListener(v -> st.showCategory(cat));
+            tab.setTag(cat);
+            tabs.addView(tab, lp);
+        }
+        done.setOnClickListener(v -> dialog.dismiss());
+        st.showCategory(st.currentCategory());
+        st.updateCurrent();
+        dialog.show();
+    }
+
+    private static int count(String cat) {
+        return Themes.in(cat).size() + (Themes.MINIMAL.equals(cat) ? 1 : 0);
+    }
+
+    /** What the gallery is showing, and the cards on screen. */
+    private static final class State {
+        final GbaControlsView view;
+        final Runnable onChange;
+        final TextView current;
+        final LinearLayout grid, tabs;
+        final List<View> cards = new ArrayList<>();
+        final Handler main = new Handler(Looper.getMainLooper());
+
+        State(GbaControlsView view, Runnable onChange, TextView current, LinearLayout grid, LinearLayout tabs) {
+            this.view = view; this.onChange = onChange; this.current = current; this.grid = grid; this.tabs = tabs;
+        }
+
+        /** The id of the theme in use: a shell, a picture, or none. */
+        String currentId() {
+            if (view.shellActive()) return Themes.ALL[view.settings().shellTheme].id;
+            int i = Themes.forBackground(GbaControlsView.getBorderBackground());
+            return i >= 0 ? Themes.ALL[i].id : NONE;
+        }
+
+        String currentCategory() {
+            int i = Themes.indexOf(currentId());
+            return i >= 0 ? Themes.ALL[i].category : Themes.MINIMAL;
+        }
+
+        void updateCurrent() {
+            int i = Themes.indexOf(currentId());
+            current.setText(i >= 0 ? "Now: " + Themes.ALL[i].name + " (" + Themes.ALL[i].category + ")" : "Now: None");
+            for (View card : cards) highlight(card, card.getTag().equals(currentId()));
+        }
+
+        void showCategory(String cat) {
+            Context c = view.getContext();
+            for (int i = 0; i < tabs.getChildCount(); i++) {
+                View tab = tabs.getChildAt(i);
+                GradientDrawable g = new GradientDrawable();
+                g.setCornerRadius(dp(c, 18));
+                boolean on = cat.equals(tab.getTag());
+                g.setColor(on ? ACCENT : 0xFF2A3038);
+                tab.setBackground(g);
+            }
+            grid.removeAllViews();
+            cards.clear();
+            List<String> ids = new ArrayList<>();
+            for (Themes t : Themes.in(cat)) {
+                // a picture theme whose image is not packaged is left out
+                if (t.isShell() || GbaControlsView.backgroundExists(c, t.background)) ids.add(t.id);
+            }
+            if (Themes.MINIMAL.equals(cat)) ids.add(NONE);
+
+            int width = c.getResources().getDisplayMetrics().widthPixels - dp(c, 24);
+            int cols = Math.max(2, Math.min(5, width / dp(c, 200)));
+            int gap = dp(c, 10);
+            LinearLayout row = null;
+            for (int k = 0; k < ids.size(); k++) {
+                if (k % cols == 0) {
+                    row = new LinearLayout(c);
+                    row.setPadding(0, 0, 0, gap);
+                    grid.addView(row);
+                }
+                View card = card(c, ids.get(k));
+                LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1);
+                lp.rightMargin = k % cols == cols - 1 ? 0 : gap;
+                row.addView(card, lp);
+                cards.add(card);
+            }
+            // pad the last row so its cards keep the same width
+            if (row != null)
+                for (int k = ids.size() % cols; k != 0 && k < cols; k++) {
+                    View filler = new View(c);
+                    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, 1, 1);
+                    lp.rightMargin = k == cols - 1 ? 0 : gap;
+                    row.addView(filler, lp);
+                }
+            updateCurrent();
+        }
+
+        View card(Context c, String id) {
+            LinearLayout card = new LinearLayout(c);
+            card.setOrientation(LinearLayout.VERTICAL);
+            card.setTag(id);
+            int p = dp(c, 4);
+            card.setPadding(p, p, p, p);
+            ImageView image = new ImageView(c) {
+                @Override protected void onMeasure(int w, int h) {
+                    int width = MeasureSpec.getSize(w);
+                    setMeasuredDimension(width, width * ThemeCard.H / ThemeCard.W);
+                }
+            };
+            image.setScaleType(ImageView.ScaleType.FIT_XY);
+            image.setBackgroundColor(0xFF0C0E12);
+            card.addView(image);
+            int i = Themes.indexOf(id);
+            TextView name = label(c, i >= 0 ? Themes.ALL[i].name : "None (black)", 13, 0xFFE6EAF0, false);
+            name.setPadding(dp(c, 2), dp(c, 4), 0, dp(c, 2));
+            card.addView(name);
+            card.setOnClickListener(v -> apply(id));
+
+            Bitmap cached = cache.get(id);
+            if (cached != null) {
+                image.setImageBitmap(cached);
+            } else {
+                Context app = c.getApplicationContext();
+                worker.execute(() -> {
+                    Bitmap b = render(app, id);
+                    if (b == null) return;
+                    cache.put(id, b);
+                    main.post(() -> image.setImageBitmap(b));
+                });
+            }
+            return card;
+        }
+
+        void apply(String id) {
+            int i = Themes.indexOf(id);
+            Themes t = i >= 0 ? Themes.ALL[i] : null;
+            // "None" and the handheld shells are the game's BACKGROUND OFF
+            // (one past the last picture); a shell is then drawn by the overlay.
+            view.settings().shellTheme = t != null && t.isShell() ? i : -1;
+            GbaControlsView.setBorderBackground(t != null && !t.isShell() ? t.background : view.backgroundOff());
+            view.settingsChanged();
+            updateCurrent();
+            if (onChange != null) onChange.run();
+        }
+    }
+
+    /** One card's picture, off the main thread. */
+    private static Bitmap render(Context c, String id) {
+        int i = Themes.indexOf(id);
+        Themes t = i >= 0 ? Themes.ALL[i] : null;
+        Bitmap out = Bitmap.createBitmap(THUMB_W, THUMB_H, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(out);
+        canvas.drawColor(Color.BLACK);
+        canvas.scale(THUMB_W / (float) ThemeCard.W, THUMB_H / (float) ThemeCard.H);
+        if (t != null && !t.isShell()) {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inSampleSize = 2;
+            try (InputStream in = c.getAssets().open(t.background == 0 ? "BG.png" : "BG" + t.background + ".png")) {
+                Bitmap bg = BitmapFactory.decodeStream(in, null, o);
+                if (bg != null) {
+                    // cover-scale, as the overlay does
+                    float s = Math.max(ThemeCard.W / (float) bg.getWidth(), ThemeCard.H / (float) bg.getHeight());
+                    int bw = Math.round(bg.getWidth() * s), bh = Math.round(bg.getHeight() * s);
+                    canvas.drawBitmap(bg, null, new Rect((ThemeCard.W - bw) / 2, (ThemeCard.H - bh) / 2,
+                            (ThemeCard.W + bw) / 2, (ThemeCard.H + bh) / 2), new Paint(Paint.FILTER_BITMAP_FLAG));
+                    bg.recycle();
+                }
+            } catch (IOException ignored) {
+                // no picture: the card shows black around the screen
+            }
+        }
+        ThemeCard.drawOver(new CanvasPainter().on(canvas), t);
+        return out;
+    }
+
+    private static void highlight(View card, boolean on) {
+        GradientDrawable g = new GradientDrawable();
+        g.setCornerRadius(dp(card.getContext(), 8));
+        g.setColor(CARD_BG);
+        if (on) g.setStroke(dp(card.getContext(), 3), ACCENT);
+        card.setBackground(g);
+    }
+
+    private static TextView label(Context c, String text, int sp, int colour, boolean bold) {
+        TextView t = new TextView(c);
+        t.setText(text);
+        t.setTextSize(sp);
+        t.setTextColor(colour);
+        t.setSingleLine(true);
+        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
+        return t;
+    }
+
+    private static int dp(Context c, int v) {
+        return Math.round(v * c.getResources().getDisplayMetrics().density);
+    }
+}
