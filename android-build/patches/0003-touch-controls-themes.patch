+package com.pokeemerald.experimental.controls;
+
+/** How the on-screen controls look. Alphas here are scaled by the user's opacity setting. */
+public final class ButtonStyle {
+    public final String name;
+    public final int face, pressed, outline, label, dpad, accentA, accentB;
+    public final boolean outlineOnly;
+
+    ButtonStyle(String name, int face, int pressed, int outline, int label, int dpad,
+                int accentA, int accentB, boolean outlineOnly) {
+        this.name = name; this.face = face; this.pressed = pressed; this.outline = outline;
+        this.label = label; this.dpad = dpad; this.accentA = accentA; this.accentB = accentB;
+        this.outlineOnly = outlineOnly;
+    }
+
+    static int argb(int a, int rgb) { return (a << 24) | (rgb & 0xFFFFFF); }
+
+    /** Index 0 is the original look. Order matters: it is what Settings stores. */
+    public static final ButtonStyle[] ALL = {
+        new ButtonStyle("Classic", argb(70, 0xFFFFFF), argb(155, 0xFFFFFF), argb(170, 0xFFFFFF),
+                argb(255, 0xFFFFFF), argb(70, 0xFFFFFF), 0, 0, false),
+        new ButtonStyle("GBA SP", argb(150, 0x2B2B33), argb(220, 0x4A4A58), argb(200, 0x111118),
+                argb(255, 0xE8E8F0), argb(160, 0x2B2B33), argb(190, 0x6B5BC8), argb(190, 0x6B5BC8), false),
+        new ButtonStyle("Famicom", argb(150, 0xD8D0C0), argb(220, 0xFFFFFF), argb(200, 0x6E1F1F),
+                argb(255, 0x3A2020), argb(170, 0x303030), argb(210, 0xB02020), argb(210, 0xB02020), false),
+        new ButtonStyle("Minimal", argb(0, 0xFFFFFF), argb(90, 0xFFFFFF), argb(150, 0xFFFFFF),
+                argb(200, 0xFFFFFF), argb(0, 0xFFFFFF), 0, 0, true),
+        new ButtonStyle("Emerald", argb(130, 0x0E6B4E), argb(210, 0x1FA67A), argb(200, 0x8FF0C8),
+                argb(255, 0xEFFFF8), argb(130, 0x0E6B4E), argb(200, 0x22B884), argb(200, 0x157A5C), false),
+        new ButtonStyle("Magma", argb(140, 0x5A1206), argb(220, 0xC8401A), argb(210, 0xFF9A3C),
+                argb(255, 0xFFE0C0), argb(140, 0x5A1206), argb(210, 0xE0501E), argb(210, 0x9A2A10), false),
+        new ButtonStyle("Aqua", argb(130, 0x0C3A6E), argb(210, 0x2A78C8), argb(210, 0x8CD0FF),
+                argb(255, 0xE6F4FF), argb(130, 0x0C3A6E), argb(200, 0x2F8AE0), argb(200, 0x1B5A9E), false),
+        new ButtonStyle("Retro Green", argb(150, 0x306230), argb(220, 0x8BAC0F), argb(220, 0x0F380F),
+                argb(255, 0x9BBC0F), argb(150, 0x306230), argb(200, 0x0F380F), argb(200, 0x0F380F), false),
+    };
+}
