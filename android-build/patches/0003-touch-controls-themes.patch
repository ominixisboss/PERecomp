@@ -0,0 +1,239 @@
+package com.pokeemerald.experimental;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.Typeface;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.AdapterView;
+import android.widget.ArrayAdapter;
+import android.widget.Button;
+import android.widget.CompoundButton;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.SeekBar;
+import android.widget.Spinner;
+import android.widget.Switch;
+import android.widget.TextView;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import com.pokeemerald.experimental.controls.ButtonStyle;
+import com.pokeemerald.experimental.controls.Settings;
+import com.pokeemerald.experimental.controls.Themes;
+
+/** The gear button's panel: theme, button style, size, opacity, toggles, layout editing. */
+final class ControlsSettingsDialog {
+    private ControlsSettingsDialog() {}
+
+    static void show(GbaControlsView view) {
+        Context c = view.getContext();
+        Settings s = view.settings();
+        int pad = dp(c, 16);
+
+        LinearLayout col = new LinearLayout(c);
+        col.setOrientation(LinearLayout.VERTICAL);
+        col.setPadding(pad, pad / 2, pad, pad / 2);
+
+        // Emerald Arena on/off. Hidden in a build without the arena.
+        final Switch realtime;
+        if (GbaControlsView.isArenaBuilt()) {
+            header(col, c, "Game");
+            realtime = toggle(c, "Real-time battles (Emerald Arena)", GbaControlsView.getArenaEnabled());
+            col.addView(realtime);
+            TextView note = new TextView(c);
+            note.setText("Off: every battle uses the classic battle screen. Takes effect from the next battle.");
+            note.setTextColor(0xFFB0B8C0);
+            col.addView(note);
+        } else {
+            realtime = null;
+        }
+
+        // Theme: opens the gallery; its name here follows what was picked.
+        header(col, c, "Theme");
+        LinearLayout themeRow = new LinearLayout(c);
+        themeRow.setOrientation(LinearLayout.HORIZONTAL);
+        themeRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
+        TextView themeName = new TextView(c);
+        themeName.setTextSize(16);
+        themeName.setTextColor(0xFFFFFFFF);
+        Button browse = new Button(c);
+        browse.setText("Browse themes");
+        themeRow.addView(themeName, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        themeRow.addView(browse);
+        col.addView(themeRow);
+        Runnable showTheme = () -> themeName.setText(currentThemeName(view));
+        showTheme.run();
+
+        // Button styles for picture themes: the flat ones only. A handheld is
+        // a theme (its body and its buttons), picked in the gallery; offering
+        // it here gave handheld buttons with no handheld around them. The
+        // stored value stays the style's index in ButtonStyle.ALL.
+        final List<Integer> styleIndex = new ArrayList<>();
+        List<String> styleNames = new ArrayList<>();
+        styleIndex.add(Settings.MATCH_THEME);
+        styleNames.add("Match theme");
+        for (int i = 0; i < ButtonStyle.ALL.length; i++)
+            if (!ButtonStyle.ALL[i].gba) { styleIndex.add(i); styleNames.add(ButtonStyle.ALL[i].name); }
+        Spinner style = spinner(c, styleNames);
+        style.setSelection(Math.max(0, styleIndex.indexOf(s.style)), false);
+        header(col, c, "Button style");
+        col.addView(style);
+        TextView styleNote = new TextView(c);
+        styleNote.setText("For picture themes. Handheld themes always use their own buttons.");
+        styleNote.setTextColor(0xFFB0B8C0);
+        col.addView(styleNote);
+
+        header(col, c, "Button size");
+        SeekBar size = seek(c, 80, Math.round((s.scale - 0.7f) * 100));
+        col.addView(size);
+        header(col, c, "Button opacity");
+        SeekBar opacity = seek(c, 80, Math.round((s.opacity - 0.2f) * 100));
+        col.addView(opacity);
+
+        Switch haptics = toggle(c, "Vibrate on press", s.haptics);
+        Switch arena = toggle(c, "Arena buttons (BALL, < >)", s.arenaButtons);
+        Switch diag = toggle(c, "Diagonal directions", s.diagonals);
+        col.addView(haptics);
+        col.addView(arena);
+        col.addView(diag);
+
+        LinearLayout row = new LinearLayout(c);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        Button edit = new Button(c);
+        edit.setText("Move buttons");
+        Button reset = new Button(c);
+        reset.setText("Reset positions");
+        row.addView(edit, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        row.addView(reset, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        col.addView(row);
+
+        // Save transfer (SaveTransfer): survive reinstalls and move saves around.
+        header(col, c, "Save");
+        TextView saveNote = new TextView(c);
+        saveNote.setText(android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.Q
+                ? "A copy is kept automatically in Downloads/PokemonEmerald whenever you leave the game."
+                : "Use Back up to keep a copy outside the app.");
+        col.addView(saveNote);
+        LinearLayout saveRow = new LinearLayout(c);
+        saveRow.setOrientation(LinearLayout.HORIZONTAL);
+        Button export = new Button(c);
+        export.setText("Back up save");
+        Button restore = new Button(c);
+        restore.setText("Restore save");
+        saveRow.addView(export, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        saveRow.addView(restore, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        col.addView(saveRow);
+
+        ScrollView scroll = new ScrollView(c);
+        scroll.addView(col);
+        final AlertDialog dialog = new AlertDialog.Builder(c, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+                .setTitle("Controls, themes & saves")
+                .setView(scroll)
+                .setPositiveButton("Done", null)
+                .create();
+
+        // Every change applies immediately, so the result is visible behind the panel.
+        browse.setOnClickListener(v -> ThemeGallery.show(view, showTheme));
+        style.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
+            @Override public void onItemSelected(AdapterView<?> p, View v, int pos, long id) {
+                s.style = styleIndex.get(pos);
+                view.settingsChanged();
+            }
+            @Override public void onNothingSelected(AdapterView<?> p) {}
+        });
+        size.setOnSeekBarChangeListener(new Seek() {
+            @Override public void onProgressChanged(SeekBar b, int v, boolean user) {
+                s.scale = 0.7f + v / 100f;
+                view.settingsChanged();
+            }
+        });
+        opacity.setOnSeekBarChangeListener(new Seek() {
+            @Override public void onProgressChanged(SeekBar b, int v, boolean user) {
+                s.opacity = 0.2f + v / 100f;
+                view.settingsChanged();
+            }
+        });
+        if (realtime != null) {
+            realtime.setOnCheckedChangeListener((b, on) -> {
+                GbaControlsView.setArenaEnabled(on);
+                // The BALL and < > buttons only mean something in the arena:
+                // follow the switch (they can still be toggled separately).
+                arena.setChecked(on);
+            });
+        }
+        CompoundButton.OnCheckedChangeListener toggles = (b, on) -> {
+            s.haptics = haptics.isChecked();
+            s.arenaButtons = arena.isChecked();
+            s.diagonals = diag.isChecked();
+            view.settingsChanged();
+        };
+        haptics.setOnCheckedChangeListener(toggles);
+        arena.setOnCheckedChangeListener(toggles);
+        diag.setOnCheckedChangeListener(toggles);
+        edit.setOnClickListener(v -> { dialog.dismiss(); view.startEditing(); });
+        reset.setOnClickListener(v -> { s.positions.clear(); view.settingsChanged(); });
+        export.setOnClickListener(v -> {
+            dialog.dismiss();
+            if (c instanceof android.app.Activity) SaveTransfer.requestExport((android.app.Activity) c);
+        });
+        restore.setOnClickListener(v -> {
+            dialog.dismiss();
+            if (c instanceof android.app.Activity) SaveTransfer.requestImport((android.app.Activity) c);
+        });
+
+        dialog.show();
+    }
+
+    /** The theme in use, for the panel: a shell, a picture, or none. */
+    private static String currentThemeName(GbaControlsView view) {
+        if (view.shellActive()) return "Handheld " + Themes.ALL[view.settings().shellTheme].name;
+        int i = Themes.forBackground(GbaControlsView.getBorderBackground());
+        return i >= 0 ? Themes.ALL[i].name + " \u00b7 " + Themes.ALL[i].category : "None (black)";
+    }
+
+    private abstract static class Seek implements SeekBar.OnSeekBarChangeListener {
+        @Override public void onStartTrackingTouch(SeekBar b) {}
+        @Override public void onStopTrackingTouch(SeekBar b) {}
+    }
+
+    private static int dp(Context c, int v) {
+        return Math.round(v * c.getResources().getDisplayMetrics().density);
+    }
+
+    private static void header(LinearLayout col, Context c, String text) {
+        TextView t = new TextView(c);
+        t.setText(text);
+        t.setTypeface(Typeface.DEFAULT_BOLD);
+        // Explicit colour: the dialog theme's default secondary text is a dark
+        // grey that all but disappears on the dark panel.
+        t.setTextColor(0xFF7FE0B4);
+        t.setTextSize(15);
+        t.setPadding(0, dp(c, 14), 0, dp(c, 2));
+        col.addView(t);
+    }
+
+    private static Spinner spinner(Context c, List<String> items) {
+        Spinner sp = new Spinner(c);
+        ArrayAdapter<String> a = new ArrayAdapter<>(c, android.R.layout.simple_spinner_item, items);
+        a.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
+        sp.setAdapter(a);
+        return sp;
+    }
+
+    private static SeekBar seek(Context c, int max, int value) {
+        SeekBar b = new SeekBar(c);
+        b.setMax(max);
+        b.setProgress(Math.max(0, Math.min(max, value)));
+        return b;
+    }
+
+    private static Switch toggle(Context c, String label, boolean on) {
+        Switch sw = new Switch(c);
+        sw.setText(label);
+        sw.setChecked(on);
+        sw.setPadding(0, dp(c, 8), 0, dp(c, 8));
+        return sw;
+    }
+}
