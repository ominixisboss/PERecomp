@@ -0,0 +1,26 @@
+package com.pokeemerald.experimental.controls;
+
+/**
+ * A theme gallery card: the theme as it looks on a phone, in miniature. Drawn
+ * at a virtual 20:9 screen of W x H (the layout needs a real screen size to
+ * place the controls) and scaled down by the caller. The caller first draws
+ * the theme's background picture cover-scaled to W x H; this draws the rest.
+ * Shared by the Android gallery and the desktop previews.
+ */
+public final class ThemeCard {
+    private ThemeCard() {}
+
+    public static final int W = 1200, H = 540;
+
+    /** theme null is "None": a black surround with the default buttons. */
+    public static void drawOver(Painter p, Themes theme) {
+        ControlsLayout l = new ControlsLayout(W, H, new Settings(), false);
+        ButtonStyle st = ButtonStyle.ALL[theme == null ? 0 : theme.style];
+        // A stand-in game screen: sky over grass. The card's name is shown
+        // under it by the gallery.
+        float horizon = l.gameB - (l.gameB - l.gameT) * 0.3f;
+        p.fillRectGradient(l.gameL, l.gameT, l.gameR, horizon, 0xFF4F78B8, 0xFF9CC4E4, l.gameT, horizon);
+        p.fillRectGradient(l.gameL, horizon, l.gameR, l.gameB, 0xFF5CA05A, 0xFF3C7444, horizon, l.gameB);
+        ControlsRenderer.draw(p, l, st, 1f, 0, null, st.gba);
+    }
+}
diff --git a/android/app/src/main/java/com/pokeemerald/experimental/controls/Themes.java b/android/app/src/main/java/com/pokeemerald/experimental/controls/Themes.java
new file mode 100644
index 000000000..4c4d0c97a
--- /dev/null
+++ b/android/app/src/main/java/com/pokeemerald/experimental/controls/Themes.java
@@ -0,0 +1,144 @@
+package com.pokeemerald.experimental.controls;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The theme catalogue, grouped into categories for the theme gallery.
+ *
+ * background is the game's BACKGROUND number (BG.png = 0, BGn.png = n), which
+ * is what the game saves, so a theme keeps its number forever and new ones
+ * are only appended. BG2.png onward come from android-build/themes/
+ * make_themes.py, which writes themes-index.txt (number -> id); ThemeCheck
+ * fails the build if this list and that file disagree. style is the button
+ * style that suits the theme. id is stable and is what settings store for a
+ * handheld shell.
+ */
+public final class Themes {
+    public final String id, name, category;
+    public final int background, style;
+
+    private Themes(String id, String name, String category, int background, int style) {
+        this.id = id; this.name = name; this.category = category;
+        this.background = background; this.style = style;
+    }
+
