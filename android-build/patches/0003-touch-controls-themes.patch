--- /dev/null
+++ b/android/app/src/main/java/com/pokeemerald/experimental/controls/Themes.java
@@ -0,0 +1,52 @@
+package com.pokeemerald.experimental.controls;
+
+/**
+ * Screen-background themes. background is the game's BACKGROUND number
+ * (BG.png = 0, BGn.png = n); style is the button style that suits it.
+ * BG2.png onward come from android-build/themes/make_themes.py, in this order.
+ */
+public final class Themes {
+    public final String name;
+    public final int background, style;
+
+    private Themes(String name, int background, int style) {
+        this.name = name; this.background = background; this.style = style;
+    }
+
+    /** background value for a handheld shell: the overlay draws it, no image. */
+    public static final int SHELL = -2;
+
+    public boolean isShell() { return background == SHELL; }
+
+    public static final Themes[] ALL = {
+        new Themes("Starfall", 0, 0),
+        new Themes("Open Sea", 1, 6),
+        new Themes("Rayquaza Sky", 2, 4),
+        new Themes("Hoenn Sunset", 3, 6),
+        new Themes("Magma", 4, 5),
+        new Themes("Starter Meadow", 5, 4),
+        new Themes("Eon Night", 6, 1),
+        new Themes("GBA Indigo", 7, 1),
+        new Themes("Classic Green", 8, 7),
+        new Themes("Handheld Indigo", SHELL, 8),
+        new Themes("Handheld Glacier", SHELL, 9),
+        new Themes("Handheld Fuchsia", SHELL, 10),
+        new Themes("Handheld Arctic", SHELL, 11),
+        new Themes("Handheld Black", SHELL, 12),
+        new Themes("Handheld Spice", SHELL, 13),
+        new Themes("Handheld Platinum", SHELL, 14),
+        new Themes("Handheld Emerald", SHELL, 15),
+    };
+
+    /** Whether the fork's Border.png frame is drawn: only on its own two backgrounds. */
+    public static boolean wantsBorderFrame(int background) {
+        return background == 0 || background == 1;
+    }
+
+    /** The theme whose background is the given BACKGROUND number, or -1 (custom/off). */
+    public static int forBackground(int background) {
+        for (int i = 0; i < ALL.length; i++)
+            if (ALL[i].background == background && background != SHELL) return i;
+        return -1;
+    }
+}
