--- /dev/null
+++ b/android/app/src/main/java/com/pokeemerald/experimental/controls/ControlsAnimator.java
@@ -0,0 +1,78 @@
+package com.pokeemerald.experimental.controls;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Press animation state: each button's travel (0 up .. 1 fully down) and the
+ * D-pad's tilt, driven by small damped springs so presses feel physical --
+ * a quick firm press, and a release that springs back with a slight bounce.
+ * Pure Java; time is passed in, so it is tested off-device.
+ */
+public final class ControlsAnimator {
+    /** One damped spring. */
+    static final class Spring {
+        float x, v;
+        void step(float target, float dt, boolean pressing) {
+            // Stiffer when pressing (a press is crisp), a little underdamped on
+            // release so the button overshoots its rest and settles.
+            float k = pressing ? 2600f : 1500f;
+            float zeta = pressing ? 1.0f : 0.55f;
+            float c = 2f * zeta * (float) Math.sqrt(k);
+            float a = k * (target - x) - c * v;
+            v += a * dt;
+            x += v * dt;
+        }
+        boolean settled(float target) {
+            return Math.abs(target - x) < 0.002f && Math.abs(v) < 0.02f;
+        }
+    }
+
+    private final Map<String, Spring> travel = new HashMap<>();
+    private final Spring tiltX = new Spring(), tiltY = new Spring();
+    private long lastNanos = -1;
+    private boolean animating;
+
+    /** Advance to time nowNanos for the given layout and pressed keys. */
+    public void step(ControlsLayout layout, int pressed, long nowNanos) {
+        float dt = lastNanos < 0 ? 0f : (nowNanos - lastNanos) / 1e9f;
+        lastNanos = nowNanos;
+        animating = false;
+        // Integrate in small fixed sub-steps: stable however irregular the
+        // frame timing is, and a long pause just settles everything.
+        dt = Math.min(dt, 0.1f);
+        int steps = Math.max(1, (int) Math.ceil(dt / 0.004f));
+        float h = dt / steps;
+
+        float tx = ((pressed & Keys.RIGHT) != 0 ? 1 : 0) - ((pressed & Keys.LEFT) != 0 ? 1 : 0);
+        float ty = ((pressed & Keys.DOWN) != 0 ? 1 : 0) - ((pressed & Keys.UP) != 0 ? 1 : 0);
+        if (tx != 0 && ty != 0) { tx *= 0.7071f; ty *= 0.7071f; }   // a diagonal rocks both arms halfway
+        boolean dpadDown = tx != 0 || ty != 0;
+
+        for (ControlsLayout.Item it : layout.items) {
+            if (it.shape == ControlsLayout.Shape.DPAD || it.keys == 0) continue;
+            Spring s = travel.get(it.id);
+            if (s == null) travel.put(it.id, s = new Spring());
+            boolean down = (pressed & it.keys) == it.keys;
+            for (int i = 0; i < steps; i++) s.step(down ? 1f : 0f, h, down);
+            if (!s.settled(down ? 1f : 0f)) animating = true;
+        }
+        for (int i = 0; i < steps; i++) {
+            tiltX.step(tx, h, dpadDown);
+            tiltY.step(ty, h, dpadDown);
+        }
+        if (!tiltX.settled(tx) || !tiltY.settled(ty)) animating = true;
+    }
+
+    /** Button travel, 0 (up) .. 1 (down); slightly negative while bouncing back. */
+    public float travel(String id) {
+        Spring s = travel.get(id);
+        return s == null ? 0f : s.x;
+    }
+
+    public float tiltX() { return tiltX.x; }
+    public float tiltY() { return tiltY.x; }
+
+    /** True while anything is still moving: keep drawing frames. */
+    public boolean animating() { return animating; }
+}
diff --git a/android/app/src/main/java/com/pokeemerald/experimental/controls/ControlsLayout.java b/android/app/src/main/java/com/pokeemerald/experimental/controls/ControlsLayout.java
new file mode 100644
index 000000000..06df38408
--- /dev/null
+++ b/android/app/src/main/java/com/pokeemerald/experimental/controls/ControlsLayout.java
@@ -0,0 +1,140 @@
+package com.pokeemerald.experimental.controls;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Where every on-screen control is, and which GBA keys a touch presses.
+ * Pure Java: no Android types, so it is unit-tested on a plain JVM.
+ */
+public final class ControlsLayout {
+    public enum Shape { DPAD, CIRCLE, PILL }
+
+    public static final class Item {
+        public final String id;
+        public final Shape shape;
+        public final int keys;          // GBA keys pressed (0 for gear/edit buttons)
+        public final String label;
+        public float cx, cy, w, h;      // centre and size in pixels
+
+        Item(String id, Shape shape, int keys, String label) {
+            this.id = id; this.shape = shape; this.keys = keys; this.label = label;
+        }
+        public float radius() { return Math.min(w, h) / 2; }
+    }
+
+    public static final String DPAD = "dpad", GEAR = "gear", DONE = "done", RESET = "reset";
+
+    public final List<Item> items = new ArrayList<>();
+    public final int width, height;
+    /** Where SDL draws the game: integer-scaled and centred. Nothing may paint inside it. */
+    public final int gameL, gameT, gameR, gameB;
+    public final boolean editing;
+    private final boolean diagonals;
+
+    public ControlsLayout(int width, int height, Settings settings, boolean editing) {
+        this.width = width; this.height = height; this.editing = editing;
+        int gs = Math.max(1, Math.min(width / 240, height / 160));
+        gameL = (width - 240 * gs) / 2; gameT = (height - 160 * gs) / 2;
+        gameR = gameL + 240 * gs; gameB = gameT + 160 * gs;
+        this.diagonals = settings.diagonals;
+
+        // The side bands left by the game screen; never narrower than 14% of
+        // the width, so a 16:9 phone still has room for thumbs.
+        float side = Math.max((width - height * 3f / 2f) / 2f, width * 0.14f);
+        float u = Math.min(side / 3f, height / 8f) * settings.scale;
+        float pillW = Math.min(side * 0.8f, u * 2.4f), pillH = u * 0.75f;
+        float button = Math.min(side * 0.42f, height / 5.5f) * settings.scale;
+
+        add(DPAD, Shape.DPAD, Keys.DIRECTIONS, null, side * 0.55f, height * 0.70f, u * 3.2f, u * 3.2f);
+        add("l", Shape.PILL, Keys.L, "L", side * 0.5f, height * 0.09f, pillW, pillH);
+        add("select", Shape.PILL, Keys.SELECT, "SELECT", side * 0.5f, height * 0.25f, pillW, pillH * 0.85f);
+        add("r", Shape.PILL, Keys.R, "R", width - side * 0.5f, height * 0.09f, pillW, pillH);
+        add("start", Shape.PILL, Keys.START, "START", width - side * 0.5f, height * 0.25f, pillW, pillH * 0.85f);
+        add("a", Shape.CIRCLE, Keys.A, "A", width - side * 0.28f, height * 0.62f, button, button);
+        add("b", Shape.CIRCLE, Keys.B, "B", width - side * 0.70f, height * 0.80f, button, button);
+        if (settings.arenaButtons) {
+            // Emerald Arena: the ball is L+R held together, which as two
+            // separate shoulder buttons needs two fingers at the top corners.
+            add("ball", Shape.PILL, Keys.L | Keys.R, "BALL", width - side * 0.5f, height * 0.41f, pillW, pillH);
+            // Attack select is L/R; these sit above the D-pad, in thumb reach.
+            add("prev", Shape.CIRCLE, Keys.L, "<", side * 0.30f, height * 0.42f, button * 0.6f, button * 0.6f);
+            add("next", Shape.CIRCLE, Keys.R, ">", side * 0.72f, height * 0.42f, button * 0.6f, button * 0.6f);
+        }
+        float g = Math.max(u * 0.55f, height * 0.045f);
+        if (editing) {
+            add(DONE, Shape.PILL, 0, "DONE", width * 0.44f, g * 0.7f, g * 3.2f, g * 1.2f);
+            add(RESET, Shape.PILL, 0, "RESET", width * 0.56f, g * 0.7f, g * 3.2f, g * 1.2f);
+        } else {
+            // In the left band between SELECT and the attack buttons: the
+            // margin above the game screen is only ~60px at 6x scale, too
+            // little for a button that does not overlap the game's HUD.
+            float gear = Math.min(g, height * 0.075f);
+            add(GEAR, Shape.CIRCLE, 0, "*", side * 0.5f, height * 0.335f, gear, gear);
+        }
+
+        for (Item it : items) {
+            float[] p = settings.positions.get(it.id);
+            if (p != null) { it.cx = p[0] * width; it.cy = p[1] * height; }
+        }
+    }
+
+    private void add(String id, Shape shape, int keys, String label, float cx, float cy, float w, float h) {
+        Item it = new Item(id, shape, keys, label);
+        it.cx = cx; it.cy = cy; it.w = w; it.h = h;
+        items.add(it);
+    }
+
+    public Item find(String id) {
+        for (Item it : items) if (it.id.equals(id)) return it;
+        return null;
+    }
+
+    /** The control under (x, y), with a forgiving margin; null if none. */
+    public Item itemAt(float x, float y) {
+        Item best = null;
+        float bestDist = Float.MAX_VALUE;
+        for (Item it : items) {
+            float dx = x - it.cx, dy = y - it.cy;
+            boolean inside;
+            if (it.shape == Shape.PILL) {
+                inside = Math.abs(dx) <= it.w * 0.6f && Math.abs(dy) <= it.h * 0.75f;
+            } else {
+                float r = it.radius() * (it.shape == Shape.DPAD ? 1.25f : 1.2f);
+                inside = dx * dx + dy * dy <= r * r;
+            }
+            float d = dx * dx + dy * dy;
+            if (inside && d < bestDist) { best = it; bestDist = d; }
+        }
+        return best;
+    }
+
+    /**
+     * Keys for a finger at (x, y) on the D-pad. The whole disc is live, so a
+     * thumb can roll between directions without lifting; the centre is a dead
+     * zone. Diagonal sectors are narrower (30 of every 90 degrees) than
+     * cardinal ones, so a slightly-off push does not press two directions --
+     * which the menus would read as a stray move.
+     */
+    public int dpadKeys(Item dpad, float x, float y) {
+        float dx = x - dpad.cx, dy = y - dpad.cy;
+        float dead = dpad.radius() * 0.22f;
+        if (dx * dx + dy * dy < dead * dead) return 0;
+        double deg = Math.toDegrees(Math.atan2(-dy, dx));   // 0 = right, 90 = up
+        if (deg < 0) deg += 360;
+        double within = deg % 90;                           // 0..90 from the last cardinal
+        int cardinal = (int) Math.round(deg / 90) % 4;      // 0 R, 1 U, 2 L, 3 D
+        int[] dirs = {Keys.RIGHT, Keys.UP, Keys.LEFT, Keys.DOWN};
+        if (diagonals && within >= 30 && within <= 60) {
+            int lower = (int) (deg / 90) % 4;
+            return dirs[lower] | dirs[(lower + 1) % 4];
+        }
+        return dirs[cardinal];
+    }
+
+    /** Keys for a finger that is on item it at (x, y). */
+    public int keysFor(Item it, float x, float y) {
+        if (it == null) return 0;
+        return it.shape == Shape.DPAD ? dpadKeys(it, x, y) : it.keys;
+    }
+}
diff --git a/android/app/src/main/java/com/pokeemerald/experimental/controls/ControlsRenderer.java b/android/app/src/main/java/com/pokeemerald/experimental/controls/ControlsRenderer.java
new file mode 100644
index 000000000..744af6a2d
--- /dev/null
+++ b/android/app/src/main/java/com/pokeemerald/experimental/controls/ControlsRenderer.java
@@ -0,0 +1,421 @@
+package com.pokeemerald.experimental.controls;
+
+/** Draws a ControlsLayout through a Painter: the same code on device and in previews. */
+public final class ControlsRenderer {
+    private static final int EDIT_OUTLINE = 0xFFFFD040;
+    /**
+     * A soft dark backing under every flat-style control, so its label stays
+     * readable over any background art -- a translucent white button with a
+     * white label over a moon or a sunlit cloud had a contrast of about 1:1.
+     * ThemeCheck measures label contrast with this backing in place.
+     */
+    public static final int BACKING = 0xA0101018, BACKING_MINIMAL = 0x60101018;
+
+    static int backing(ButtonStyle st, float o) {
+        return fade(st.outlineOnly ? BACKING_MINIMAL : BACKING, o);
+    }
+
+    private ControlsRenderer() {}
+
+    static int fade(int argb, float opacity) {
+        int a = Math.round(((argb >>> 24) & 0xFF) * opacity);
+        return (a << 24) | (argb & 0xFFFFFF);
+    }
+
+    public static void draw(Painter p, ControlsLayout layout, ButtonStyle st, float opacity, int pressed) {
+        draw(p, layout, st, opacity, pressed, null, false);
+    }
+
+    /**
+     * anim supplies press travel and D-pad tilt (null: snap to pressed);
+     * shell draws the handheld body around the game screen first.
+     */
+    public static void draw(Painter p, ControlsLayout layout, ButtonStyle st, float opacity, int pressed,
+                            ControlsAnimator anim, boolean shell) {
+        if (st.gba) {
+            if (shell) drawShell(p, layout, st);
+            Hardware.draw(p, layout, st, opacity, pressed, anim);
+            return;
+        }
+        for (ControlsLayout.Item it : layout.items) {
+            float o = it.keys == 0 ? Math.max(opacity, 0.6f) : opacity;   // gear/edit stay findable
+            boolean down = it.keys != 0 && (pressed & it.keys) == it.keys
+                    && it.shape != ControlsLayout.Shape.DPAD;
+            switch (it.shape) {
+            case DPAD:   drawDpad(p, it, st, o, pressed & Keys.DIRECTIONS, layout.editing); break;
+            case CIRCLE: drawCircle(p, it, st, o, down, layout.editing); break;
+            case PILL:   drawPill(p, it, st, o, down, layout.editing); break;
+            }
+        }
+        if (layout.editing) {
+            float size = layout.height * 0.035f;
+            p.text("Drag controls to move them", layout.width / 2f, layout.height - size * 1.2f, size, 0xFFFFFFFF);
+        }
+    }
+
+    /** The 12 corners of a plus sign of half-length r and half-width arm. */
+    static float[] crossOutline(float cx, float cy, float r, float arm) {
+        return new float[] {
+            cx - arm, cy - r,   cx + arm, cy - r,   cx + arm, cy - arm,
+            cx + r, cy - arm,   cx + r, cy + arm,   cx + arm, cy + arm,
+            cx + arm, cy + r,   cx - arm, cy + r,   cx - arm, cy + arm,
+            cx - r, cy + arm,   cx - r, cy - arm,   cx - arm, cy - arm};
+    }
+
+    private static int faceFor(ButtonStyle st, ControlsLayout.Item it, boolean down) {
+        if (down) return st.pressed;
+        if ("a".equals(it.id) && st.accentA != 0) return st.accentA;
+        if ("b".equals(it.id) && st.accentB != 0) return st.accentB;
+        return st.face;
+    }
+
+    private static void drawCircle(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, boolean down, boolean edit) {
+        float r = it.radius();
+        // The gear gets a dark backing: on a light theme with a faint style it
+        // would otherwise be hard to find, and it is the way into settings.
+        if (ControlsLayout.GEAR.equals(it.id)) p.fillCircle(it.cx, it.cy, r, 0x99000000);
+        else p.fillCircle(it.cx, it.cy, r, backing(st, o));
+        int f = faceFor(st, it, down), ink = fade(inkOn(st, f), o);
+        p.fillCircle(it.cx, it.cy, r, fade(f, o));
+        p.strokeCircle(it.cx, it.cy, r, Math.max(2, r * 0.07f), edit ? EDIT_OUTLINE : fade(st.outline, o));
+        if (ControlsLayout.GEAR.equals(it.id)) {
+            drawGear(p, it.cx, it.cy, r * 0.62f, ink);
+        } else if (it.label != null) {
+            p.text(it.label, it.cx, it.cy, r * 0.95f, ink);
+        }
+    }
+
+    private static void drawGear(Painter p, float cx, float cy, float r, int c) {
+        for (int i = 0; i < 8; i++) {
+            double a = Math.PI / 4 * i;
+            p.fillCircle(cx + (float) Math.cos(a) * r * 0.82f, cy + (float) Math.sin(a) * r * 0.82f, r * 0.24f, c);
+        }
+        p.fillCircle(cx, cy, r * 0.72f, c);
+        p.fillCircle(cx, cy, r * 0.3f, 0x00000000);
+        p.strokeCircle(cx, cy, r * 0.3f, Math.max(1, r * 0.12f), 0x80000000);
+    }
+
+    private static void drawPill(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, boolean down, boolean edit) {
+        float l = it.cx - it.w / 2, t = it.cy - it.h / 2, rr = it.h / 2;
+        p.fillRoundRect(l, t, l + it.w, t + it.h, rr, backing(st, o));
+        int f = faceFor(st, it, down);
+        p.fillRoundRect(l, t, l + it.w, t + it.h, rr, fade(f, o));
+        p.strokeRoundRect(l, t, l + it.w, t + it.h, rr, Math.max(2, it.h * 0.06f), edit ? EDIT_OUTLINE : fade(st.outline, o));
+        if (it.label != null) {
+            float size = Math.min(it.h * 0.55f, it.w / Math.max(1, it.label.length() * 0.62f));
+            p.text(it.label, it.cx, it.cy, size, fade(inkOn(st, f), o));
+        }
+    }
+
+    private static void drawDpad(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, int dirs, boolean edit) {
+        float r = it.radius(), arm = r * 0.36f, round = arm * 0.35f;
+        int face = fade(st.dpad, o), outline = edit ? EDIT_OUTLINE : fade(st.outline, o);
+        float stroke = Math.max(2, r * 0.035f);
+        // A faint disc shows the live area: the whole circle tracks the thumb.
+        p.fillCircle(it.cx, it.cy, r * 1.08f, fade(0x22FFFFFF, o));
+        // The cross is one polygon, filled and outlined once. Drawn as two
+        // overlapping bars, a translucent face doubled up in the middle and
+        // both outlines ran across the centre.
+        float[] cross = crossOutline(it.cx, it.cy, r, arm);
+        p.fillPolygon(cross, backing(st, o));
+        p.fillPolygon(cross, face);
+        p.strokePolygon(cross, stroke, outline);
+        // pressed arms
+        int lit = fade(st.pressed, o);
+        if ((dirs & Keys.UP) != 0)    p.fillRoundRect(it.cx - arm, it.cy - r, it.cx + arm, it.cy - arm, round, lit);
+        if ((dirs & Keys.DOWN) != 0)  p.fillRoundRect(it.cx - arm, it.cy + arm, it.cx + arm, it.cy + r, round, lit);
+        if ((dirs & Keys.LEFT) != 0)  p.fillRoundRect(it.cx - r, it.cy - arm, it.cx - arm, it.cy + arm, round, lit);
+        if ((dirs & Keys.RIGHT) != 0) p.fillRoundRect(it.cx + arm, it.cy - arm, it.cx + r, it.cy + arm, round, lit);
+        // arrows
+        int c = fade(inkOn(st, st.dpad), o * 0.85f);
+        float a = arm * 0.55f, tip = r * 0.88f, base = r * 0.55f;
+        p.fillTriangle(it.cx, it.cy - tip, it.cx - a, it.cy - base, it.cx + a, it.cy - base, c);
+        p.fillTriangle(it.cx, it.cy + tip, it.cx - a, it.cy + base, it.cx + a, it.cy + base, c);
+        p.fillTriangle(it.cx - tip, it.cy, it.cx - base, it.cy - a, it.cx - base, it.cy + a, c);
+        p.fillTriangle(it.cx + tip, it.cy, it.cx + base, it.cy - a, it.cx + base, it.cy + a, c);
+    }
+
+    // ---- colour helpers -----------------------------------------------------
+
+    static int mix(int a, int b, float t) {
+        t = t < 0 ? 0 : t > 1 ? 1 : t;
+        int r = 0;
+        for (int sh = 0; sh < 32; sh += 8) {
+            int ca = (a >>> sh) & 0xFF, cb = (b >>> sh) & 0xFF;
+            r |= (Math.round(ca + (cb - ca) * t) & 0xFF) << sh;
+        }
+        return r;
+    }
+    /** f > 0 lightens toward white, f < 0 darkens toward black; alpha kept. */
+    static int shade(int argb, float f) {
+        int target = f >= 0 ? (argb & 0xFF000000) | 0xFFFFFF : argb & 0xFF000000;
+        return mix(argb, target, Math.abs(f));
+    }
+    /** An engraving on a face: darker, unless the face is already too dark
+     *  for a darker mark to show, then lighter. */
+    static int engrave(int argb) {
+        int r = (argb >> 16) & 0xFF, g = (argb >> 8) & 0xFF, b = argb & 0xFF;
+        return (r * 299 + g * 587 + b * 114) / 1000 < 70 ? shade(argb, 0.30f) : shade(argb, -0.5f);
+    }
+    /** WCAG relative luminance of an opaque colour. */
+    static double luminance(int rgb) {
+        double l = 0;
+        double[] w = {0.2126, 0.7152, 0.0722};
+        for (int i = 0; i < 3; i++) {
+            double v = ((rgb >> (16 - 8 * i)) & 0xFF) / 255.0;
+            l += w[i] * (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
+        }
+        return l;
+    }
+    public static double contrast(int a, int b) {
+        double x = luminance(a), y = luminance(b);
+        return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+    }
+    /** a composited over b, ignoring b's alpha. */
+    static int over(int a, int b) {
+        return 0xFF000000 | (mix(b, a, ((a >>> 24) & 0xFF) / 255f) & 0xFFFFFF);
+    }
+    /** What a flat control's face looks like on screen: the face over the
+     *  backing over a mid-tone background. */
+    public static int seenFace(ButtonStyle st, int face) {
+        return over(face, over(st.outlineOnly ? BACKING_MINIMAL : BACKING, 0xFF707078));
+    }
+    /** The style's label colour, unless it does not read on this face (the
+     *  Famicom style's dark ink on its red A and dark D-pad), then whichever
+     *  of near-white or near-black reads better. Alpha kept. */
+    public static int inkOn(ButtonStyle st, int face) {
+        int seen = seenFace(st, face), label = st.label;
+        if (contrast(label, seen) >= 3.0) return label;
+        int light = 0xF4F4F8, dark = 0x141418;
+        return (label & 0xFF000000) | (contrast(light, seen) >= contrast(dark, seen) ? light : dark);
+    }
+    static int alpha(int argb, int a) { return (a << 24) | (argb & 0xFFFFFF); }
+
+    // ---- the handheld body ---------------------------------------------------
+
+    /** For tests: the shell alone. */
+    public static void drawShellForTest(Painter p, ControlsLayout l, ButtonStyle st) { drawShell(p, l, st); }
+
+    /** Plastic shell, screen bezel, power LED, speaker grille and screws -- all
+     *  outside the game rectangle, which SDL draws underneath this overlay. */
+    static void drawShell(Painter p, ControlsLayout l, ButtonStyle st) {
+        int w = l.width, h = l.height;
+        int top = shade(st.shell, 0.10f), bottom = st.shellShade;
+        float[][] regions = {
+            {0, 0, w, l.gameT}, {0, l.gameB, w, h}, {0, l.gameT, l.gameL, l.gameB}, {l.gameR, l.gameT, w, l.gameB}};
+        for (float[] r : regions)
+            if (r[2] > r[0] && r[3] > r[1]) p.fillRectGradient(r[0], r[1], r[2], r[3], top, bottom, 0, h);
+        // A soft sheen across the top, as moulded plastic catches light.
+        p.fillRectGradient(0, 0, l.gameL, h * 0.18f, alpha(0xFFFFFF, 40), alpha(0xFFFFFF, 0), 0, h * 0.18f);
+        p.fillRectGradient(l.gameR, 0, w, h * 0.18f, alpha(0xFFFFFF, 40), alpha(0xFFFFFF, 0), 0, h * 0.18f);
+
+        // Screen bezel: a dark lens frame hugging the game, never over it.
+        float margin = Math.min(Math.min(l.gameT, h - l.gameB), Math.min(l.gameL, w - l.gameR));
+        float t = Math.max(4, Math.min(h * 0.05f, Math.max(margin * 0.9f, h * 0.02f)));
+        // Two bands: straight bars hugging the game edge, then a rounded ring
+        // further out. A rounded stroke's inner edge cuts each corner inward,
+        // so a single ring at the edge would paint wedges over the game's
+        // corner pixels; pushed out by t/2 its corner cuts land in the bars.
+        float g0 = l.gameL, g1 = l.gameT, g2 = l.gameR, g3 = l.gameB, half = t / 2;
+        p.fillRoundRect(g0 - half, g1 - half, g2 + half, g1, 0, st.bezel);
+        p.fillRoundRect(g0 - half, g3, g2 + half, g3 + half, 0, st.bezel);
+        p.fillRoundRect(g0 - half, g1, g0, g3, 0, st.bezel);
+        p.fillRoundRect(g2, g1, g2 + half, g3, 0, st.bezel);
+        float ring = t * 0.75f;
+        p.strokeRoundRect(g0 - ring, g1 - ring, g2 + ring, g3 + ring, t * 0.6f, half + 1, st.bezel);
+        p.strokeRoundRect(g0 - t, g1 - t, g2 + t, g3 + t, t * 0.85f, Math.max(1, t * 0.08f),
+                shade(st.shell, -0.35f));
+        // the lens edge catching light, two pixels out
+        p.strokeRoundRect(g0 - 2.5f, g1 - 2.5f, g2 + 2.5f, g3 + 2.5f, 2.5f, 1.5f, alpha(0xFFFFFF, 50));
+
+        // Power LED with a little glow, on the left of the bezel.
+        float led = Math.max(3, h * 0.008f), lx = l.gameL - t * 0.5f, ly = l.gameT + h * 0.10f;
+        if (l.gameL - t > led * 3) {
+            lx = l.gameL - t - Math.max(led * 6, h * 0.035f);
+            p.fillCircleRadial(lx, ly, led * 3, lx, ly, alpha(0x7CFF6A, 110), alpha(0x7CFF6A, 0));
+            p.fillCircle(lx, ly, led, 0xFF8CFF7A);
+            p.text("POWER", lx, ly + led * 3.4f, Math.max(8, h * 0.016f), alpha(st.ink, 200));
+        }
+
+        // Speaker grille, bottom right: rows of slanted slots.
+        // It ends left of the bottom-right screw rather than running into it.
+        float dot = Math.max(2, h * 0.006f), sr = Math.max(3, h * 0.009f);
+        float gx = w * 0.975f - sr * 1.3f - dot * 3 - dot * 4 * 3.2f - dot, gy = h - h * 0.075f;
+        for (int row = 0; row < 3; row++)
+            for (int col = 0; col < 5; col++)
+                p.fillCircle(gx + col * dot * 3.2f - row * dot * 1.6f, gy + row * dot * 3.2f, dot,
+                        shade(st.shellShade, -0.45f));
+
+        // Screws.
+        float[][] screws = {{w * 0.025f, h * 0.04f}, {w * 0.975f, h * 0.04f}, {w * 0.025f, h * 0.96f}, {w * 0.975f, h * 0.96f}};
+        for (float[] sc : screws) {
+            p.fillCircle(sc[0], sc[1], sr * 1.3f, shade(st.shellShade, -0.2f));
+            p.fillCircleRadial(sc[0], sc[1], sr, sc[0] - sr * 0.3f, sc[1] - sr * 0.3f, 0xFFB8B8C0, 0xFF5A5A62);
+            p.fillRoundRect(sc[0] - sr * 0.7f, sc[1] - sr * 0.12f, sc[0] + sr * 0.7f, sc[1] + sr * 0.12f, 1, 0xFF404048);
+        }
+    }
+
+    /** The hardware skin's buttons, animated by a ControlsAnimator. */
+    static final class Hardware {
+        private Hardware() {}
+
+        static void draw(Painter p, ControlsLayout l, ButtonStyle st, float o, int pressed, ControlsAnimator anim) {
+            for (ControlsLayout.Item it : l.items) {
+                float travel = anim != null ? anim.travel(it.id)
+                        : (it.keys != 0 && (pressed & it.keys) == it.keys ? 1f : 0f);
+                if (it.shape == ControlsLayout.Shape.DPAD) {
+                    float tx, ty;
+                    if (anim != null) { tx = anim.tiltX(); ty = anim.tiltY(); }
+                    else {
+                        tx = ((pressed & Keys.RIGHT) != 0 ? 1 : 0) - ((pressed & Keys.LEFT) != 0 ? 1 : 0);
+                        ty = ((pressed & Keys.DOWN) != 0 ? 1 : 0) - ((pressed & Keys.UP) != 0 ? 1 : 0);
+                        if (tx != 0 && ty != 0) { tx *= 0.7071f; ty *= 0.7071f; }
+                    }
+                    pad(p, it, st, o, tx, ty, l.editing);
+                } else if (it.keys == 0) {
+                    drawCircleOrPill(p, it, st, o, l.editing);          // gear, DONE, RESET
+                } else if (it.id.equals("l") || it.id.equals("r")) {
+                    shoulder(p, it, st, o, travel, l.editing);
+                } else if (it.shape == ControlsLayout.Shape.CIRCLE) {
+                    dome(p, it, st, o, travel, l.editing);
+                } else {
+                    rubber(p, it, st, o, travel, l.editing);
+                }
+            }
+        }
+
+        private static void drawCircleOrPill(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, boolean edit) {
+            if (it.shape == ControlsLayout.Shape.PILL) drawPill(p, it, st, Math.max(o, 0.6f), false, edit);
+            else drawCircle(p, it, st, Math.max(o, 0.6f), false, edit);
+        }
+
+        /** Domed A/B: sinks, flattens and darkens with travel; overshoots on release. */
+        private static void dome(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, float t, boolean edit) {
+            float r = it.radius() * 0.86f;
+            boolean small = !it.id.equals("a") && !it.id.equals("b");
+            // the hole in the shell the button sits in
+            p.fillCircle(it.cx, it.cy + r * 0.04f, r * 1.12f, fade(shade(st.shellShade, -0.35f), o));
+            // drop shadow shrinks as the button goes down
+            p.fillCircle(it.cx + r * 0.05f, it.cy + r * (0.12f - 0.08f * t), r * 1.01f, fade(alpha(0, 90), o * (1 - 0.6f * t)));
+            float rr = r * (1 - 0.08f * t), cy = it.cy + r * 0.06f * t;
+            float lift = 1 - 0.65f * Math.max(0, Math.min(1, t));
+            int face = st.buttonFace;
+            p.fillCircleRadial(it.cx, cy, rr, it.cx - rr * 0.38f * lift, cy - rr * 0.42f * lift,
+                    fade(shade(face, 0.40f * lift), o), fade(shade(face, -0.30f - 0.12f * t), o));
+            // specular glint, gone when pressed flat
+            p.fillCircleRadial(it.cx - rr * 0.35f, cy - rr * 0.42f, rr * 0.38f, it.cx - rr * 0.35f, cy - rr * 0.42f,
+                    fade(alpha(0xFFFFFF, Math.round(150 * lift)), o), fade(alpha(0xFFFFFF, 0), o));
+            if (edit) p.strokeCircle(it.cx, it.cy, it.radius(), 3, EDIT_OUTLINE);
+            if (small) {
+                p.text(it.label, it.cx, cy, rr * 0.9f, fade(shade(face, -0.6f), o));
+            } else {
+                // A and B are printed on the shell beside the button, as on the hardware.
+                p.text(it.label, it.cx + r * 1.05f, it.cy + r * 1.05f, r * 0.5f, fade(st.ink, o));
+            }
+        }
+
+        /** START/SELECT/BALL: small rubber pills with the label printed below. */
+        private static void rubber(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, float t, boolean edit) {
+            float w = it.w * 0.78f, h = Math.min(it.h * 0.55f, w * 0.32f);
+            float cx = it.cx, cy = it.cy - it.h * 0.12f;
+            p.fillRoundRect(cx - w / 2 - h * 0.12f, cy - h / 2 - h * 0.12f + h * 0.08f, cx + w / 2 + h * 0.12f,
+                    cy + h / 2 + h * 0.12f + h * 0.08f, h, fade(shade(st.shellShade, -0.35f), o));
+            float sw = w * (1 - 0.05f * t), sh = h * (1 - 0.18f * t), dy = h * 0.12f * t;
+            p.fillRoundRect(cx - sw / 2, cy - sh / 2 + dy, cx + sw / 2, cy + sh / 2 + dy, sh / 2,
+                    fade(shade(st.rubber, 0.18f - 0.3f * Math.max(0, t)), o));
+            p.fillRoundRect(cx - sw / 2 + sh * 0.2f, cy - sh / 2 + dy + sh * 0.12f, cx + sw / 2 - sh * 0.2f,
+                    cy - sh * 0.05f + dy, sh / 3, fade(alpha(0xFFFFFF, Math.round(45 * (1 - Math.max(0, t)))), o));
+            if (edit) p.strokeRoundRect(it.cx - it.w / 2, it.cy - it.h / 2, it.cx + it.w / 2, it.cy + it.h / 2, it.h / 2, 3, EDIT_OUTLINE);
+            p.text(it.label, cx, cy + h * 1.15f, Math.max(8, it.h * 0.36f), fade(st.ink, o));
+        }
+
+        /** L/R: the shoulder buttons, in a lighter tone of the shell; dip when pressed. */
+        private static void shoulder(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, float t, boolean edit) {
+            float l = it.cx - it.w / 2, top = it.cy - it.h / 2, r = it.cx + it.w / 2, b = it.cy + it.h / 2;
+            float dy = it.h * 0.14f * t;
+            p.fillRoundRect(l, top + it.h * 0.10f, r, b + it.h * 0.10f, it.h * 0.45f, fade(shade(st.shellShade, -0.3f), o));
+            int face = shade(st.shell, 0.22f - 0.25f * Math.max(0, t));
+            p.fillRoundRect(l, top + dy, r, b + dy - it.h * 0.06f, it.h * 0.45f, fade(face, o));
+            p.fillRoundRect(l + it.h * 0.3f, top + dy + it.h * 0.08f, r - it.h * 0.3f, top + dy + it.h * 0.24f, it.h * 0.08f,
+                    fade(alpha(0xFFFFFF, Math.round(70 * (1 - Math.max(0, t)))), o));
+            if (edit) p.strokeRoundRect(l, top, r, b, it.h * 0.45f, 3, EDIT_OUTLINE);
+            p.text(it.label, it.cx, it.cy + dy, it.h * 0.5f, fade(st.ink, o));
+        }
+
+        /**
+         * The cross pad, pivoting on its centre like the real rocker: the pressed
+         * arm sinks (foreshortened and darker), the opposite arm rises into the
+         * light, the whole cross slides a touch toward the press, and its
+         * shadow shifts. (tx, ty) is the tilt, a point in the unit disc.
+         */
+        private static void pad(Painter p, ControlsLayout.Item it, ButtonStyle st, float o,
+                                float tx, float ty, boolean edit) {
+            float r = it.radius() * 0.92f, a = r * 0.34f;
+            float cx = it.cx + tx * r * 0.05f, cy = it.cy + ty * r * 0.05f;
+            int face = st.padFace;
+            // the round well moulded into the shell
+            p.fillCircle(it.cx, it.cy + r * 0.03f, r * 1.1f, fade(shade(st.shellShade, -0.22f), o));
+            p.fillCircleRadial(it.cx, it.cy, r * 1.06f, it.cx, it.cy - r * 0.3f,
+                    fade(shade(st.shell, -0.05f), o), fade(shade(st.shellShade, -0.25f), o));
+            // shadow of the cross: longer on the side that is raised
+            float sx = r * 0.06f - tx * r * 0.05f, sy = r * 0.09f - ty * r * 0.05f;
+            cross(p, it.cx + sx, it.cy + sy, r, a, 0, 0, fade(alpha(0, 110), o), true);
+            // a thin lighter rim, moving with each arm, so a black cross still
+            // reads on a dark shell
+            int rim = fade(alpha(shade(face, 0.40f), 150), o);
+            for (float[] d : new float[][] {{0, -1}, {1, 0}, {0, 1}, {-1, 0}}) {
+                float k = d[0] * tx + d[1] * ty;
+                float len = r * (1 - 0.11f * Math.max(0, k) + 0.035f * Math.max(0, -k));
+                float tip = a * (1 - 0.07f * k);
+                arm(p, cx, cy, d, a * 1.07f, len + a * 0.07f, tip * 1.07f + a * 0.0f, rim);
+            }
+            // the cross itself, arm by arm
+            float[][] dirs = {{0, -1}, {1, 0}, {0, 1}, {-1, 0}};
+            for (float[] d : dirs) {
+                float k = d[0] * tx + d[1] * ty;                 // how far this arm is pushed down
+                float len = r * (1 - 0.11f * Math.max(0, k) + 0.035f * Math.max(0, -k));
+                float tip = a * (1 - 0.07f * k);
+                int c = k > 0 ? shade(face, -0.45f * k) : shade(face, 0.10f * -k);
+                arm(p, cx, cy, d, a, len, tip, fade(c, o));
+                // moulded highlight along the arm's upper edge, fading as it sinks
+                int hl = fade(alpha(0xFFFFFF, Math.round(60 * (1 - 0.8f * Math.max(0, k)) + 30 * Math.max(0, -k))), o);
+                hilite(p, cx, cy, d, a, len, tip, hl);
+                // engraved arrow near the tip
+                float m = len * 0.72f, s2 = a * 0.42f;
+                float ax = cx + d[0] * m, ay = cy + d[1] * m, px = -d[1], py = d[0];
+                p.fillTriangle(ax + d[0] * s2, ay + d[1] * s2, ax - d[0] * s2 * 0.4f + px * s2, ay - d[1] * s2 * 0.4f + py * s2,
+                        ax - d[0] * s2 * 0.4f - px * s2, ay - d[1] * s2 * 0.4f - py * s2, fade(engrave(c), o));
+            }
+            // centre hub with its dimple
+            p.fillRoundRect(cx - a, cy - a, cx + a, cy + a, a * 0.2f, fade(face, o));
+            p.fillCircleRadial(cx, cy, a * 0.7f, cx + a * 0.18f, cy + a * 0.22f,
+                    fade(shade(face, -0.45f), o), fade(shade(face, 0.12f), o));
+            if (edit) p.strokeCircle(it.cx, it.cy, it.radius(), 3, EDIT_OUTLINE);
+        }
+
+        private static void arm(Painter p, float cx, float cy, float[] d, float a, float len, float tip, int c) {
+            float px = -d[1], py = d[0];
+            p.fillPolygon(new float[] {
+                cx + d[0] * a + px * a, cy + d[1] * a + py * a,
+                cx + d[0] * len + px * tip, cy + d[1] * len + py * tip,
+                cx + d[0] * len - px * tip, cy + d[1] * len - py * tip,
+                cx + d[0] * a - px * a, cy + d[1] * a - py * a}, c);
+        }
+
+        private static void hilite(Painter p, float cx, float cy, float[] d, float a, float len, float tip, int c) {
+            // the edge facing up-left catches the light
+            float px = -d[1], py = d[0];
+            float side = (px + py) < 0 ? 1 : -1;                     // pick the up/left-facing edge
+            float e0 = a * 0.92f, e1 = tip * 0.92f, w = a * 0.12f;
+            p.fillPolygon(new float[] {
+                cx + d[0] * a + side * px * e0, cy + d[1] * a + side * py * e0,
+                cx + d[0] * len * 0.96f + side * px * e1, cy + d[1] * len * 0.96f + side * py * e1,
+                cx + d[0] * len * 0.96f + side * px * (e1 - w), cy + d[1] * len * 0.96f + side * py * (e1 - w),
+                cx + d[0] * a + side * px * (e0 - w), cy + d[1] * a + side * py * (e0 - w)}, c);
+        }
+
+        private static void cross(Painter p, float cx, float cy, float r, float a, float tx, float ty, int c, boolean flat) {
+            p.fillPolygon(crossOutline(cx, cy, r, a), c);   // one shape: no doubled centre
+        }
+    }
+}
