+        gba("Handheld Kyogre",   0x1E4EA6, 0x113274, 0xF6CACA, 0xE24A4A, 0x14182A),
+        gba("Handheld Groudon",  0xB4342A, 0x7A1E16, 0xFFE0A6, 0xECE4D8, 0x1C1C22),
+        gba("Handheld Gold",     0xC9A23C, 0x8E701E, 0x3A2A08, 0xF4ECD6, 0x2A2418),
