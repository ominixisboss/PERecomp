@@ -0,0 +1,98 @@
+package com.pokeemerald.experimental.controls;
+
+/** Draws a ControlsLayout through a Painter: the same code on device and in previews. */
+public final class ControlsRenderer {
+    private static final int EDIT_OUTLINE = 0xFFFFD040;
+
+    private ControlsRenderer() {}
+
+    static int fade(int argb, float opacity) {
+        int a = Math.round(((argb >>> 24) & 0xFF) * opacity);
+        return (a << 24) | (argb & 0xFFFFFF);
+    }
+
+    public static void draw(Painter p, ControlsLayout layout, ButtonStyle st, float opacity, int pressed) {
+        for (ControlsLayout.Item it : layout.items) {
+            float o = it.keys == 0 ? Math.max(opacity, 0.6f) : opacity;   // gear/edit stay findable
+            boolean down = it.keys != 0 && (pressed & it.keys) == it.keys
+                    && it.shape != ControlsLayout.Shape.DPAD;
+            switch (it.shape) {
+            case DPAD:   drawDpad(p, it, st, o, pressed & Keys.DIRECTIONS, layout.editing); break;
+            case CIRCLE: drawCircle(p, it, st, o, down, layout.editing); break;
+            case PILL:   drawPill(p, it, st, o, down, layout.editing); break;
+            }
+        }
+        if (layout.editing) {
+            float size = layout.height * 0.035f;
+            p.text("Drag controls to move them", layout.width / 2f, layout.height - size * 1.2f, size, 0xFFFFFFFF);
+        }
+    }
+
+    private static int faceFor(ButtonStyle st, ControlsLayout.Item it, boolean down) {
+        if (down) return st.pressed;
+        if ("a".equals(it.id) && st.accentA != 0) return st.accentA;
+        if ("b".equals(it.id) && st.accentB != 0) return st.accentB;
+        return st.face;
+    }
+
+    private static void drawCircle(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, boolean down, boolean edit) {
+        float r = it.radius();
+        // The gear gets a dark backing: on a light theme with a faint style it
+        // would otherwise be hard to find, and it is the way into settings.
+        if (ControlsLayout.GEAR.equals(it.id)) p.fillCircle(it.cx, it.cy, r, 0x99000000);
+        p.fillCircle(it.cx, it.cy, r, fade(faceFor(st, it, down), o));
+        p.strokeCircle(it.cx, it.cy, r, Math.max(2, r * 0.07f), edit ? EDIT_OUTLINE : fade(st.outline, o));
+        if (ControlsLayout.GEAR.equals(it.id)) {
+            drawGear(p, it.cx, it.cy, r * 0.62f, fade(st.label, o));
+        } else if (it.label != null) {
+            p.text(it.label, it.cx, it.cy, r * 0.95f, fade(st.label, o));
+        }
+    }
+
+    private static void drawGear(Painter p, float cx, float cy, float r, int c) {
+        for (int i = 0; i < 8; i++) {
+            double a = Math.PI / 4 * i;
+            p.fillCircle(cx + (float) Math.cos(a) * r * 0.82f, cy + (float) Math.sin(a) * r * 0.82f, r * 0.24f, c);
+        }
+        p.fillCircle(cx, cy, r * 0.72f, c);
+        p.fillCircle(cx, cy, r * 0.3f, 0x00000000);
+        p.strokeCircle(cx, cy, r * 0.3f, Math.max(1, r * 0.12f), 0x80000000);
+    }
+
+    private static void drawPill(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, boolean down, boolean edit) {
+        float l = it.cx - it.w / 2, t = it.cy - it.h / 2, rr = it.h / 2;
+        p.fillRoundRect(l, t, l + it.w, t + it.h, rr, fade(faceFor(st, it, down), o));
+        p.strokeRoundRect(l, t, l + it.w, t + it.h, rr, Math.max(2, it.h * 0.06f), edit ? EDIT_OUTLINE : fade(st.outline, o));
+        if (it.label != null) {
+            float size = Math.min(it.h * 0.55f, it.w / Math.max(1, it.label.length() * 0.62f));
+            p.text(it.label, it.cx, it.cy, size, fade(st.label, o));
+        }
+    }
+
+    private static void drawDpad(Painter p, ControlsLayout.Item it, ButtonStyle st, float o, int dirs, boolean edit) {
+        float r = it.radius(), arm = r * 0.36f, round = arm * 0.35f;
+        int face = fade(st.dpad, o), outline = edit ? EDIT_OUTLINE : fade(st.outline, o);
+        float stroke = Math.max(2, r * 0.035f);
+        // A faint disc shows the live area: the whole circle tracks the thumb.
+        p.fillCircle(it.cx, it.cy, r * 1.08f, fade(0x22FFFFFF, o));
+        // cross
+        p.fillRoundRect(it.cx - arm, it.cy - r, it.cx + arm, it.cy + r, round, face);
+        p.fillRoundRect(it.cx - r, it.cy - arm, it.cx + r, it.cy + arm, round, face);
+        p.strokeRoundRect(it.cx - arm, it.cy - r, it.cx + arm, it.cy + r, round, stroke, outline);
+        p.strokeRoundRect(it.cx - r, it.cy - arm, it.cx + r, it.cy + arm, round, stroke, outline);
+        p.fillRoundRect(it.cx - arm + stroke, it.cy - arm + stroke, it.cx + arm - stroke, it.cy + arm - stroke, round, face);
+        // pressed arms
+        int lit = fade(st.pressed, o);
+        if ((dirs & Keys.UP) != 0)    p.fillRoundRect(it.cx - arm, it.cy - r, it.cx + arm, it.cy - arm, round, lit);
+        if ((dirs & Keys.DOWN) != 0)  p.fillRoundRect(it.cx - arm, it.cy + arm, it.cx + arm, it.cy + r, round, lit);
+        if ((dirs & Keys.LEFT) != 0)  p.fillRoundRect(it.cx - r, it.cy - arm, it.cx - arm, it.cy + arm, round, lit);
+        if ((dirs & Keys.RIGHT) != 0) p.fillRoundRect(it.cx + arm, it.cy - arm, it.cx + r, it.cy + arm, round, lit);
+        // arrows
+        int c = fade(st.label, o * 0.85f);
+        float a = arm * 0.55f, tip = r * 0.88f, base = r * 0.55f;
+        p.fillTriangle(it.cx, it.cy - tip, it.cx - a, it.cy - base, it.cx + a, it.cy - base, c);
+        p.fillTriangle(it.cx, it.cy + tip, it.cx - a, it.cy + base, it.cx + a, it.cy + base, c);
+        p.fillTriangle(it.cx - tip, it.cy, it.cx - base, it.cy - a, it.cx - base, it.cy + a, c);
+        p.fillTriangle(it.cx + tip, it.cy, it.cx + base, it.cy - a, it.cx + base, it.cy + a, c);
+    }
+}
