+package com.pokeemerald.experimental.controls;
+
+/** How the on-screen controls look. Alphas here are scaled by the user's opacity setting. */
+public final class ButtonStyle {
+    public final String name;
+    public final int face, pressed, outline, label, dpad, accentA, accentB;
+    public final boolean outlineOnly;
+
+    /** Handheld skin: drawn as hardware -- a plastic shell around the screen,
+     *  domed A/B, a pivoting cross pad, rubber START/SELECT -- and animated. */
+    public final boolean gba;
+    public final int shell, shellShade, bezel, ink, buttonFace, padFace, rubber;
+
+    ButtonStyle(String name, int face, int pressed, int outline, int label, int dpad,
+                int accentA, int accentB, boolean outlineOnly) {
+        this.name = name; this.face = face; this.pressed = pressed; this.outline = outline;
+        this.label = label; this.dpad = dpad; this.accentA = accentA; this.accentB = accentB;
+        this.outlineOnly = outlineOnly;
+        gba = false; shell = shellShade = bezel = ink = buttonFace = padFace = rubber = 0;
+    }
+
+    private ButtonStyle(String name, int shell, int shellShade, int ink, int buttonFace, int padFace) {
+        this.name = name;
+        gba = true;
+        this.shell = 0xFF000000 | shell; this.shellShade = 0xFF000000 | shellShade;
+        this.bezel = 0xFF2A2A31; this.ink = 0xFF000000 | ink;
+        this.buttonFace = 0xFF000000 | buttonFace; this.padFace = 0xFF000000 | padFace;
+        this.rubber = 0xFF3A3A40;
+        // Flat-skin fields, used for the gear and the layout editor.
+        face = argb(150, padFace); pressed = argb(220, buttonFace); outline = argb(200, ink);
+        label = argb(255, 0xF0F0F4); dpad = argb(200, padFace); accentA = accentB = 0; outlineOnly = false;
+    }
+
+    /** Hardware skins, appended so stored style indices keep their meaning. */
+    static ButtonStyle gba(String name, int shell, int shellShade, int ink, int buttonFace, int padFace) {
+        return new ButtonStyle(name, shell, shellShade, ink, buttonFace, padFace);
+    }
+
+    static int argb(int a, int rgb) { return (a << 24) | (rgb & 0xFFFFFF); }
+
+    /** Index 0 is the original look. Order matters: it is what Settings stores. */
+    public static final ButtonStyle[] ALL = {
+        new ButtonStyle("Classic", argb(70, 0xFFFFFF), argb(155, 0xFFFFFF), argb(170, 0xFFFFFF),
+                argb(255, 0xFFFFFF), argb(70, 0xFFFFFF), 0, 0, false),
