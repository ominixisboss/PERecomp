+    // One permanent key for every build. Android only installs an update
+    // signed with the same key as the installed app; without this each CI
+    // run signed with a fresh throwaway debug key, so installing a new build
+    // meant uninstalling first -- which deletes the save. The key comes from
+    // repository secrets (see android-build/SIGNING.md); without them the
+    // build falls back to the throwaway debug key, as before.
+    def stableKeystore = System.getenv('POKEEMERALD_KEYSTORE')
