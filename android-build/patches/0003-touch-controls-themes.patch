diff --git a/android/app/src/main/java/com/pokeemerald/experimental/CanvasPainter.java b/android/app/src/main/java/com/pokeemerald/experimental/CanvasPainter.java
new file mode 100644
index 000000000..44f3cbe4b
--- /dev/null
+++ b/android/app/src/main/java/com/pokeemerald/experimental/CanvasPainter.java
@@ -0,0 +1,75 @@
+package com.pokeemerald.experimental;
+
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.RadialGradient;
+import android.graphics.Shader;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+
+import com.pokeemerald.experimental.controls.Painter;
+
+/** The controls' Painter over an Android Canvas. */
+final class CanvasPainter implements Painter {
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private final Path path = new Path();
+    private Canvas canvas;
+
+    CanvasPainter() {
+        fill.setStyle(Paint.Style.FILL);
+        stroke.setStyle(Paint.Style.STROKE);
+        text.setTextAlign(Paint.Align.CENTER);
+        text.setTypeface(Typeface.DEFAULT_BOLD);
+    }
+
+    CanvasPainter on(Canvas c) { canvas = c; return this; }
+
+    @Override public void fillCircle(float cx, float cy, float r, int argb) {
+        fill.setColor(argb); canvas.drawCircle(cx, cy, r, fill);
+    }
+    @Override public void strokeCircle(float cx, float cy, float r, float width, int argb) {
+        stroke.setColor(argb); stroke.setStrokeWidth(width); canvas.drawCircle(cx, cy, r, stroke);
+    }
+    @Override public void fillRoundRect(float l, float t, float r, float b, float radius, int argb) {
+        fill.setColor(argb); rect.set(l, t, r, b); canvas.drawRoundRect(rect, radius, radius, fill);
+    }
+    @Override public void strokeRoundRect(float l, float t, float r, float b, float radius, float width, int argb) {
+        stroke.setColor(argb); stroke.setStrokeWidth(width); rect.set(l, t, r, b);
+        canvas.drawRoundRect(rect, radius, radius, stroke);
+    }
+    @Override public void fillTriangle(float x1, float y1, float x2, float y2, float x3, float y3, int argb) {
+        fill.setColor(argb); path.reset(); path.moveTo(x1, y1); path.lineTo(x2, y2); path.lineTo(x3, y3);
+        path.close(); canvas.drawPath(path, fill);
+    }
+    @Override public void fillPolygon(float[] xy, int argb) {
+        fill.setColor(argb); path.reset(); path.moveTo(xy[0], xy[1]);
+        for (int i = 2; i < xy.length; i += 2) path.lineTo(xy[i], xy[i + 1]);
+        path.close(); canvas.drawPath(path, fill);
+    }
+    @Override public void strokePolygon(float[] xy, float width, int argb) {
+        stroke.setColor(argb); stroke.setStrokeWidth(width); stroke.setStrokeJoin(Paint.Join.ROUND);
+        path.reset(); path.moveTo(xy[0], xy[1]);
+        for (int i = 2; i < xy.length; i += 2) path.lineTo(xy[i], xy[i + 1]);
+        path.close(); canvas.drawPath(path, stroke);
+    }
+    @Override public void fillRectGradient(float l, float t, float r, float b, int top, int bottom, float g0, float g1) {
+        fill.setShader(new LinearGradient(0, g0, 0, g1, top, bottom, Shader.TileMode.CLAMP));
+        canvas.drawRect(l, t, r, b, fill);
+        fill.setShader(null);
+    }
+    @Override public void fillCircleRadial(float cx, float cy, float r, float fx, float fy, int inner, int outer) {
+        fill.setShader(new RadialGradient(fx, fy, Math.max(1, r), inner, outer, Shader.TileMode.CLAMP));
+        canvas.drawCircle(cx, cy, r, fill);
+        fill.setShader(null);
+    }
+    @Override public void text(String s, float cx, float cy, float size, int argb) {
+        text.setColor(argb); text.setTextSize(size);
+        Paint.FontMetrics m = text.getFontMetrics();
+        canvas.drawText(s, cx, cy - (m.ascent + m.descent) / 2, text);
+    }
+}
