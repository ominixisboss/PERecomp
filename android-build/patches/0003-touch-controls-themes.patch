+package com.pokeemerald.experimental.controls;
+
+/**
+ * The few drawing primitives the controls need. Implemented over an Android
+ * Canvas on the device and over Java2D for previews and tests, so both run
+ * exactly the same layout and drawing code. Colours are ARGB ints.
+ */
+public interface Painter {
+    void fillCircle(float cx, float cy, float r, int argb);
+    void strokeCircle(float cx, float cy, float r, float width, int argb);
+    void fillRoundRect(float l, float t, float r, float b, float radius, int argb);
+    void strokeRoundRect(float l, float t, float r, float b, float radius, float width, int argb);
+    void fillTriangle(float x1, float y1, float x2, float y2, float x3, float y3, int argb);
+    /** Text centred on (cx, cy). */
+    void text(String s, float cx, float cy, float size, int argb);
+}
diff --git a/android/app/src/main/java/com/pokeemerald/experimental/controls/Settings.java b/android/app/src/main/java/com/pokeemerald/experimental/controls/Settings.java
new file mode 100644
index 000000000..293544d64
--- /dev/null
+++ b/android/app/src/main/java/com/pokeemerald/experimental/controls/Settings.java
@@ -0,0 +1,64 @@
+package com.pokeemerald.experimental.controls;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * User preferences for the controls, serialised to one string so the Android
+ * side can keep it in SharedPreferences and tests can round-trip it.
+ */
+public final class Settings {
+    public static final int MATCH_THEME = -1;
+
+    public int style = MATCH_THEME;     // ButtonStyle index, or MATCH_THEME
+    public float opacity = 1f;          // 0.2 .. 1, multiplies style alphas
+    public float scale = 1f;            // 0.7 .. 1.5, multiplies control sizes
+    public boolean haptics = true;
+    public boolean arenaButtons = true;
+    public boolean diagonals = true;
+    /** Moved controls: id -> {x, y} as fractions of the view size. */
+    public final Map<String, float[]> positions = new HashMap<>();
+
+    public static float clamp(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
+
+    public String serialize() {
+        StringBuilder s = new StringBuilder();
+        s.append("v=1;style=").append(style).append(";opacity=").append(opacity)
+         .append(";scale=").append(scale).append(";haptics=").append(haptics ? 1 : 0)
+         .append(";arena=").append(arenaButtons ? 1 : 0).append(";diag=").append(diagonals ? 1 : 0);
+        for (Map.Entry<String, float[]> e : positions.entrySet())
+            s.append(";pos.").append(e.getKey()).append('=').append(e.getValue()[0]).append(',').append(e.getValue()[1]);
+        return s.toString();
+    }
+
+    /** Never throws: anything unreadable keeps its default. */
+    public static Settings parse(String text) {
+        Settings s = new Settings();
+        if (text == null) return s;
+        for (String part : text.split(";")) {
+            int eq = part.indexOf('=');
+            if (eq <= 0) continue;
+            String k = part.substring(0, eq), v = part.substring(eq + 1);
+            try {
+                switch (k) {
+                case "style":   s.style = Integer.parseInt(v); break;
+                case "opacity": s.opacity = clamp(Float.parseFloat(v), 0.2f, 1f); break;
+                case "scale":   s.scale = clamp(Float.parseFloat(v), 0.7f, 1.5f); break;
+                case "haptics": s.haptics = !v.equals("0"); break;
+                case "arena":   s.arenaButtons = !v.equals("0"); break;
+                case "diag":    s.diagonals = !v.equals("0"); break;
+                default:
+                    if (k.startsWith("pos.")) {
+                        String[] xy = v.split(",");
+                        s.positions.put(k.substring(4), new float[] {
+                            clamp(Float.parseFloat(xy[0]), 0f, 1f), clamp(Float.parseFloat(xy[1]), 0f, 1f)});
+                    }
+                }
+            } catch (RuntimeException ignored) {
+                // keep the default for this key
+            }
+        }
+        if (s.style < MATCH_THEME || s.style >= ButtonStyle.ALL.length) s.style = MATCH_THEME;
+        return s;
+    }
+}
diff --git a/android/app/src/main/java/com/pokeemerald/experimental/controls/Themes.java b/android/app/src/main/java/com/pokeemerald/experimental/controls/Themes.java
