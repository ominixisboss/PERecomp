+                keyAlias 'pokeemerald'
+                keyPassword System.getenv('POKEEMERALD_KEYSTORE_PASSWORD')
+            }
+        }
+    }
+    buildTypes {
+        debug {
+            if (stableKeystore) {
+                signingConfig signingConfigs.stable
+            }
+        }
+    }
+
