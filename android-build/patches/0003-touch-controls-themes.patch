@@ -0,0 +1,19 @@
+package com.pokeemerald.experimental.controls;
+
+/** GBA key bits, the same values the game uses for REG_KEYINPUT. */
+public final class Keys {
+    public static final int A = 1 << 0;
+    public static final int B = 1 << 1;
+    public static final int SELECT = 1 << 2;
+    public static final int START = 1 << 3;
+    public static final int RIGHT = 1 << 4;
+    public static final int LEFT = 1 << 5;
+    public static final int UP = 1 << 6;
+    public static final int DOWN = 1 << 7;
+    public static final int R = 1 << 8;
+    public static final int L = 1 << 9;
+    public static final int[] ALL = {A, B, SELECT, START, RIGHT, LEFT, UP, DOWN, R, L};
+    public static final int DIRECTIONS = UP | DOWN | LEFT | RIGHT;
+
+    private Keys() {}
+}
diff --git a/android/app/src/main/java/com/pokeemerald/experimental/controls/Painter.java b/android/app/src/main/java/com/pokeemerald/experimental/controls/Painter.java
