+// Synchronous adapter for the arena's physical collision. These are the SAME
+// accuracy/critical/damage/STAB/type/variance commands used by normal moves.
+// Eligibility excludes unsupported script, status, weather or item effects.
+// The arena runs one native `accuracycheck failPtr, move` synchronously by
+// assembling it into a scratch buffer whose failure branch is the byte just
+// past the instruction. That instruction is opcode + pointer + halfword: 7
+// bytes on the GBA, 11 on a 64-bit build, where the pointer must also be
+// written at full width -- a u32 copy of a stack address loses its top half.
+#define ARENA_ACC_END (1 + sizeof(void *) + 2)
+static void ArenaWriteAccuracyCheck(u8 *scratch)
+{
+    uintptr_t failure = (uintptr_t)(scratch + ARENA_ACC_END);
+    u32 i;
+
+    for (i = 0; i < sizeof(void *); i++)
+        scratch[1 + i] = failure >> (8 * i);
+}
+
+s32 RealtimeArena_ResolveDamage(u8 attacker, u8 target, u16 move)
+{
+    const u8 *savedScript = gBattlescriptCurrInstr;
+    u8 savedStack = gBattleResources->battleScriptsStack->size;
+    u8 scratch[16] = {0};
+    s32 result;
+    gBattlerAttacker = attacker;
+    gBattlerTarget = target;
+    gCurrentMove = move;
+    gDynamicBasePower = 0;
+    if (move == MOVE_ROLLOUT)
+    {
+        gDynamicBasePower = gBattleMoves[move].power << min(gArenaRolloutStage, 3);
+        if (gBattleMons[attacker].status2 & STATUS2_DEFENSE_CURL) gDynamicBasePower *= 2;
+    }
+    gBattleStruct->dynamicMoveType = 0;
+    gBattleScripting.dmgMultiplier = 1;
+    gCritMultiplier = 1;
+    gMoveResultFlags = 0;
+    gBattleMoveDamage = 0;
+    gCurrentTurnActionNumber = 0;
+    gBattlerByTurnOrder[0] = attacker;
+    gBattlerByTurnOrder[1] = target;
+    ArenaWriteAccuracyCheck(scratch);
+    // ACC_CURR_MOVE is zero. Both accuracy branches end inside scratch.
+    gBattlescriptCurrInstr = scratch;
+    Cmd_accuracycheck();
+    // Native accuracy calls the native absorbing-ability hook. Finish its
+    // synchronous HP result here rather than running a presentation script.
+    if (!(gMoveResultFlags & MOVE_RESULT_NO_EFFECT)
+        && ((gBattleMons[target].ability == ABILITY_FLASH_FIRE && gBattleMoves[move].type == TYPE_FIRE
+             && !(gBattleMons[target].status1 & STATUS1_FREEZE))
+            || (gBattleMons[target].ability == ABILITY_WATER_ABSORB && gBattleMoves[move].type == TYPE_WATER
+                && gBattleMoves[move].power)))
+    {
+        if (gBattleMons[target].ability == ABILITY_WATER_ABSORB)
+        {
+            u16 hp=min(gBattleMons[target].maxHP,gBattleMons[target].hp+max(1,gBattleMons[target].maxHP/4));
+            gBattleMons[target].hp=hp;
+            SetMonData(target?&gEnemyParty[gBattlerPartyIndexes[target]]:&gPlayerParty[gBattlerPartyIndexes[target]],MON_DATA_HP,&hp);
+        }
+        gMoveResultFlags|=MOVE_RESULT_DOESNT_AFFECT_FOE;
+        if (attacker == 0) gBattleResults.lastUsedMovePlayer = move;
+        else gBattleResults.lastUsedMoveOpponent = move;
+        gBattlescriptCurrInstr=savedScript;
+        gBattleResources->battleScriptsStack->size=savedStack;
+        return 0;
+    }
+    if (!(gMoveResultFlags & MOVE_RESULT_NO_EFFECT))
+    {
+        if (move == MOVE_NIGHT_SHADE || move == MOVE_SEISMIC_TOSS)
+        {
+            // The original LevelDamage script: immunity first, fixed level
+            // damage, no STAB/critical/random variance or effectiveness bonus.
+            Cmd_typecalc();
+            gMoveResultFlags &= ~(MOVE_RESULT_SUPER_EFFECTIVE | MOVE_RESULT_NOT_VERY_EFFECTIVE);
+            Cmd_dmgtolevel();
+            Cmd_adjustsetdamage();
+        }
+        else
+        {
+            Cmd_critcalc();
+            Cmd_damagecalc();
+            Cmd_typecalc();
+            Cmd_adjustnormaldamage();
+        }
+    }
+    result = (gMoveResultFlags & MOVE_RESULT_NO_EFFECT) ? 0 : gBattleMoveDamage;
+    if (attacker == 0) gBattleResults.lastUsedMovePlayer = move;
+    else gBattleResults.lastUsedMoveOpponent = move;
+    gBattlescriptCurrInstr = savedScript;
+    // Absorbing abilities may push a presentation continuation into scratch.
+    // Never retain that stack-local pointer for a later native menu/turn.
+    gBattleResources->battleScriptsStack->size=savedStack;
+    return result;
+}
