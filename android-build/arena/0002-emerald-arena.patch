+// Bounded synchronous secondary effects. Burn delegates to the native status
+// eligibility routine; stat drops keep the native mutation and Shield Dust rule.
+// Bite's turn flinch becomes a brief interrupt in the real-time action layer.
+bool8 RealtimeArena_InflictStatus(u8 attacker, u8 target, u8 effect, bool8 ability)
+{
+    const u8 *savedScript=gBattlescriptCurrInstr;
+    u8 scratch[16]={0};
+    u8 oldEffect=gBattleCommunication[MOVE_EFFECT_BYTE];
+    u8 oldBattler=gEffectBattler,oldScripting=gBattleScripting.battler;
+    u8 oldAttacker=gBattlerAttacker,oldTarget=gBattlerTarget;
+    u8 savedStack=gBattleResources->battleScriptsStack->size;
+    u32 oldHitMarker=gHitMarker,oldStatus=gBattleMons[target].status1;
+    if(effect!=MOVE_EFFECT_BURN && effect!=MOVE_EFFECT_POISON && effect!=MOVE_EFFECT_PARALYSIS
+       &&effect!=MOVE_EFFECT_SLEEP &&effect!=MOVE_EFFECT_FREEZE &&effect!=MOVE_EFFECT_TOXIC)return FALSE;
+    gBattlerAttacker=attacker;gBattlerTarget=target;
+    gBattlescriptCurrInstr=scratch;
+    gBattleCommunication[MOVE_EFFECT_BYTE]=effect;
+    if(ability)gHitMarker|=HITMARKER_STATUS_ABILITY_EFFECT;
+    sArenaApplyingBurn=TRUE;
+    SetMoveEffect(FALSE,0);
+    sArenaApplyingBurn=FALSE;
+    gBattleCommunication[MOVE_EFFECT_BYTE]=oldEffect;
+    gEffectBattler=oldBattler;gBattleScripting.battler=oldScripting;
+    gBattlerAttacker=oldAttacker;gBattlerTarget=oldTarget;
+    gHitMarker=oldHitMarker;gBattlescriptCurrInstr=savedScript;
+    gBattleResources->battleScriptsStack->size=savedStack;
+    if(oldStatus==gBattleMons[target].status1)return FALSE;
+    SetMonData(target?&gEnemyParty[gBattlerPartyIndexes[target]]:&gPlayerParty[gBattlerPartyIndexes[target]],
+        MON_DATA_STATUS,&gBattleMons[target].status1);
+    // The reflected status is one application, not a recursive bounce.
+    if(gBattleMons[target].ability==ABILITY_SYNCHRONIZE && !gBattleMons[attacker].status1
+       &&(effect==MOVE_EFFECT_BURN||effect==MOVE_EFFECT_POISON||effect==MOVE_EFFECT_PARALYSIS||effect==MOVE_EFFECT_TOXIC))
+    {
+        u8 oldAbility=gBattleMons[attacker].ability;
+        // Suppress only a second Synchronize, retaining immunity abilities.
+        if(oldAbility==ABILITY_SYNCHRONIZE)gBattleMons[attacker].ability=ABILITY_NONE;
+        RealtimeArena_InflictStatus(target,attacker,effect,TRUE);
+        gBattleMons[attacker].ability=oldAbility;
+    }
+    return TRUE;
+}
