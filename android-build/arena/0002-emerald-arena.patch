+// For callers that dereference the profile directly. On the GBA a NULL
+// profile was read from BIOS memory at address 0 and quietly produced junk;
+// on any OS it is a crash -- an enemy whose selected move has no arena
+// profile segfaulted TickEnemy. A zeroed profile is ARENA_MOVE_NONE: no move.
+const struct ArenaMoveProfile *ArenaMoves_Profile(u16 move)
+{
+    static const struct ArenaMoveProfile sNoProfile;
+    const struct ArenaMoveProfile *p = ArenaMoves_Get(move);
+    return p ? p : &sNoProfile;
+}
