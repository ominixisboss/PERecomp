+static EWRAM_DATA u8 sArenaPartyChoice = 0;
+static void WaitForArenaPartyChoice(void)
+{
+    if (gMain.callback2 != BattleMainCB2 || gPaletteFade.active || gBattleControllerExecFlags)
+        return;
+    gActiveBattler = 0;
+    if (!sArenaPartyChoice)
+    {
+        if(gArenaMenuRequest==1)
+            BtlController_EmitChooseItem(B_COMM_TO_CONTROLLER,gBattleStruct->battlerPartyOrders[0]);
+        else
+            BtlController_EmitChoosePokemon(B_COMM_TO_CONTROLLER, PARTY_ACTION_CHOOSE_MON,
+                PARTY_SIZE, ABILITY_NONE, gBattleStruct->battlerPartyOrders[0]);
+        MarkBattlerForControllerExec(0);
+        sArenaPartyChoice = 1;
+        return;
+    }
+    sArenaPartyChoice = 0;
+    if ((gArenaMenuRequest==1 && !(gBattleBufferB[0][1]|(gBattleBufferB[0][2]<<8)))
+        || (gArenaMenuRequest!=1 && gBattleBufferB[0][1]>=PARTY_SIZE))
+    {
+        gArenaMenuRequest=0;
+        gBattleMainFunc = HandleTurnActionSelectionState;
+        return;
+    }
+    if(gArenaMenuRequest==1)
+        gLastUsedItem=gBattleBufferB[0][1]|(gBattleBufferB[0][2]<<8);
+    else UpdateBattlerPartyOrdersOnSwitch();
+    gCurrentTurnActionNumber = 0;
+    gBattlerByTurnOrder[0] = 0;
+    gBattlerByTurnOrder[1] = 1;
+    gActionsByTurnOrder[0] = gArenaMenuRequest==1?B_ACTION_USE_ITEM:B_ACTION_SWITCH;
+    gActionsByTurnOrder[1] = B_ACTION_NOTHING_FAINTED;
+    gActionsByTurnOrder[2] = B_ACTION_FINISHED;
+    gCurrentActionFuncId = gActionsByTurnOrder[0];
+    gArenaMenuRequest=0;
+    gBattleResources->battleScriptsStack->size = 0;
+    gBattleMainFunc = RunTurnActionsFunctions;
+}
